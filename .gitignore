# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
# Reviewed, non-secret template references are a shared project contract.
!**/templates/proxmox-catalog.tfvars
# Project-owned, non-secret references to existing infrastructure.
!**/config/platform.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc
*.tfplan

# Packer
.packer.d/
packer_cache/
*.pkrvars.hcl
!*.example
*.auto.pkrvars.hcl

# Local template catalog and transferred image artifacts
**/templates/proxmox.yml
**/templates/artifacts/*
!**/templates/artifacts/.gitkeep

# Ansible
*.retry
**/ansible/inventory/*.yml
!**/ansible/inventory/*.example
**/ansible/group_vars/*.yml
!**/ansible/group_vars/*.example
**/ansible/host_vars/

# Secrets and local overlays
secrets/
# Capability documentation only; all other files in these folders stay ignored.
!/docs/01-architecture/19-secrets/
/docs/01-architecture/19-secrets/*
!/docs/01-architecture/19-secrets/README.md
!/docs/05-operations/secrets/
/docs/05-operations/secrets/*
!/docs/05-operations/secrets/README.md
!/docs/auto-docs/*/secrets/
/docs/auto-docs/*/secrets/*
!/docs/auto-docs/*/secrets/README.md
/docs/auto-docs/*/19-secrets/*
!/docs/auto-docs/*/19-secrets/README.md
*.bak.*
*.local
.env
.env.*
*.pem
*.key
*.pub
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
*.vault
kubeconfig*
talosconfig*

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary local validation output
.tmp/
.venv/
__pycache__/
*.py[cod]

# Local security-logging drill manifests, raw exports and reports
.logging-evidence/

# Retired local configuration retained during layout cleanup
.local-archive/
