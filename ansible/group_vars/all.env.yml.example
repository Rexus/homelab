# Copy to: ansible/group_vars/all.<env>.yml
# Replace every value before use.
# This file is an environment overlay. It does not repeat platform_hostname or
# platform_fqdn because those derived values are owned by all.yml.
# Reference: docs/reference/infrastructure-automation-layout.md

platform_environment: lab1
# Use either a prefix or suffix when you deploy the same logical inventory more
# than once. Include separators in the value, for example lab1- or -lab1.
platform_hostname_prefix: lab1-
# Suffix is inserted before the numeric suffix, so ca-root-1 becomes
# ca-root-lab1-1.
platform_hostname_suffix: ""
# Domain suffix for this environment. platform_fqdn becomes:
# <generated_platform_hostname>.<platform_domain>
platform_domain: lab1.example.com

# Keep entries for the guests you deploy in this environment. Keys must match
# ansible/inventory/hosts.yml and Terraform vm_instances/lxc_instances keys.
# Change the IPs for each environment.
# Use dhcp only for guests that are intentionally dynamic.
platform_host_ips:
  idm-1: 10.10.12.10
  idm-2: 10.10.12.11
  ca-1: 10.20.21.10
  ca-root-1: 10.20.22.10
  idp-1: 10.10.11.10
  edge-lb-1: 10.30.30.10
  edge-lb-2: 10.30.30.11
  vault-1: 10.20.20.21
  lab-1: 10.20.20.10
  support-1: 10.20.20.11
  hsm-1: 10.20.21.20
  hsm-2: 10.20.21.21
  crypto-admin-1: 10.20.22.20
