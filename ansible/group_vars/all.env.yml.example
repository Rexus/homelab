# Copy to: ansible/group_vars/all.<env>.yml
# Replace every value before use.
# This file is an environment overlay. It does not repeat platform_hostname or
# platform_fqdn because those derived values are owned by all.yml.
# Reference: docs/reference/infrastructure-automation-layout.md

platform_environment: test
# Use either a prefix or suffix when you deploy the same logical inventory more
# than once. Do not include separators; they are added automatically.
# Example: ca-root-1 with prefix test becomes test-ca-root-1.
# Suffix is inserted before the numeric suffix, so ca-root-1 with suffix test
# becomes ca-root-test-1.
platform_hostname_prefix: ""
platform_hostname_suffix: ""
# Domain suffix for this environment. platform_fqdn becomes:
# <generated_platform_hostname>.<platform_domain>
# Use an environment subdomain here, such as test.example.com,
# lab1.example.com, stage.example.com, or tenant-a.example.com.
platform_domain: test.example.com

# This environment file does not define guest IPs. Override them in the
# matching setup overlay, such as foundation.test.yml or edge.test.yml.

# Shared cache proxy address for this environment. Leave empty when hosts have
# direct egress, internal mirrors, or offline repos. The VIP is the keepalived
# address; the URL intentionally uses an FQDN.
# Example: cache.test.example.com resolves to <cache_proxy_vip>.
# When this environment consumes a shared cache from another environment,
# override cache_proxy_fqdn to that shared cache DNS name.
cache_proxy_vip_cidr: ""
cache_proxy_name: cache
cache_proxy_fqdn: "{{ cache_proxy_name }}.{{ platform_domain }}"
cache_proxy_port: 3128
cache_proxy_vip: >-
  {{
    cache_proxy_vip_cidr | regex_replace('/.*$', '')
    if cache_proxy_vip_cidr | default('') | trim
    else ''
  }}
cache_proxy_url: >-
  {{
    'http://'
    ~ cache_proxy_fqdn
    ~ ':'
    ~ cache_proxy_port
    if (
      cache_proxy_vip_cidr | default('') | trim
      and cache_proxy_fqdn | default('') | trim
    )
    else ''
  }}
baseline_package_proxy_url: "{{ cache_proxy_url }}"
baseline_package_proxy_fqdn: "{{ cache_proxy_fqdn }}"
baseline_package_proxy_ip: "{{ cache_proxy_vip }}"
