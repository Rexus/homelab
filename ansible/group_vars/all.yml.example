# Copy to: ansible/group_vars/all.yml
# Replace every value before use.
# This is the production/default settings file. It is used when you run without
# --env, and it also owns shared derived values used by environment overlays.
# Reference: docs/reference/infrastructure-automation-layout.md

# SSH user created by cloud-init on the cloned guests.
ansible_user: automation-change-me
ansible_port: 22

# Keep inventory host keys stable. Set these per environment when the same
# logical inventory is deployed more than once.
platform_environment: prod
# Use either a prefix or suffix when you deploy the same logical inventory more
# than once. Do not include separators; they are added automatically.
platform_hostname_prefix: ""
# Suffix is inserted before the numeric suffix, so ca-root-1 with suffix test
# becomes ca-root-test-1.
platform_hostname_suffix: ""
# Use a private internal subdomain, not the public website apex.
# Common examples are corp.example.com or internal.example.com.
platform_domain: corp.example.com

# Keep hostname generation here so all.<env>.yml only has to override prefix,
# suffix, domain, and IP values.
platform_hostname_prefix_normalized: >-
  {{
    (platform_hostname_prefix ~ '-')
    if platform_hostname_prefix | default('') | trim
    else ''
  }}
platform_hostname_suffix_normalized: >-
  {{
    ('-' ~ platform_hostname_suffix)
    if platform_hostname_suffix | default('') | trim
    else ''
  }}
platform_hostname: >-
  {{
    platform_hostname_prefix_normalized ~ (
      inventory_hostname
      | regex_replace('^(.*)-([0-9]+)$', '\\1' ~ platform_hostname_suffix_normalized ~ '-\\2')
      if platform_hostname_suffix
      else inventory_hostname
    )
  }}
platform_fqdn: "{{ platform_hostname }}.{{ platform_domain }}"

# Terraform also reads this map when it provisions guests, so IP addresses are
# owned once and shared by both Terraform and Ansible.
# The keys must match ansible/inventory/hosts.yml and Terraform guest maps.
# When you add or uncomment a host, update this map and the matching
# Terraform vm_instances for that path.
# Use dhcp only for guests that are intentionally dynamic.
platform_host_ips:
  # Shared private-domain path.
  # Guide: docs/paths/shared-services/identity.md
  idm-1: 10.10.12.10
  idm-2: 10.10.12.11
  ca-1: 10.20.21.10

  # Shared private-domain path: optional root CA host.
  # Guide: docs/paths/shared-services/identity.md
  # ca-root-1: 10.20.22.10

  # Edge load-balancer path.
  # Guide: docs/paths/shared-services/edge.md
  edge-lb-1: 10.30.30.10
  edge-lb-2: 10.30.30.11
  # edge-lb-3: 10.30.30.12

  # Cache path.
  # Guide: docs/paths/shared-services/cache.md
  cache-1: 10.30.30.20
  cache-2: 10.30.30.21
  # cache-3: 10.30.30.22

  # Access path: identity provider hosts.
  # Guide: docs/architecture/network.md
  # idp-1: 10.10.11.10

  # Vault path.
  # Guide: docs/paths/shared-services/vault.md
  vault-1: 10.20.20.21

  # System control path: backends and dashboards.
  # Guide: docs/paths/system-control/observability.md
  health-1: 10.20.30.10
  metrics-1: 10.20.30.11
  apm-1: 10.20.30.12
  logs-1: 10.20.30.20
  # logs-2: 10.20.30.21
  # logs-3: 10.20.30.22
  telemetry-ui-1: 10.20.30.30

  # System control path: telemetry gateways.
  # Guide: docs/paths/system-control/observability.md
  telemetry-1: 10.20.31.10
  # telemetry-2: 10.20.31.11

  # System control path: security telemetry collectors.
  # Guide: docs/paths/system-control/observability.md
  syslog-1: 10.20.32.10
  # syslog-2: 10.20.32.11

  # System control path: archive writer.
  # Guide: docs/paths/system-control/observability.md
  archive-1: 10.20.40.10

  # Application platform path: Podman image runner.
  # Guide: docs/paths/application-platform/podman-runner.md
  runner-1: 10.20.20.30
  # runner-2: 10.20.20.31

  # Application platform path: development platform.
  # Guide: docs/paths/application-platform/development.md
  git-1: 10.20.20.35

  # Application platform path: image-based Linux template builder.
  # Guide: docs/paths/application-platform/image-based-linux.md
  rhel-10-immu-tmpl: 10.20.20.40

  # Proxmox platform path: mutable Enterprise Linux template refresh.
  # Guide: docs/platforms/proxmox/enterprise-linux-template.md
  alma-10-tmpl-stage: 10.20.20.41

  # Lab path.
  # Guide: docs/paths/private-cloud-maturity.md
  lab-1: 10.20.20.10
  support-1: 10.20.20.11

  # HSM path: active gateways.
  # Guide: docs/security/usb-hsm-active-active-blueprint.md
  hsm-1: 10.20.21.20
  hsm-2: 10.20.21.21

  # HSM path: cryptography administration helper.
  # Guide: docs/security/usb-hsm-active-active-blueprint.md
  # crypto-admin-1: 10.20.22.20

# Baseline defaults applied by Ansible roles.
baseline_timezone: Europe/Stockholm
baseline_ntp_enabled: true
