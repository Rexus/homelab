# Copy to: ansible/group_vars/all.yml
# Replace every value before use.
# This is the production/default settings file. It is used when you run without
# --env, and it also owns shared derived values used by environment overlays.
# Reference: docs/reference/infrastructure-automation-layout.md

# SSH user created by cloud-init on the cloned guests.
ansible_user: automation
ansible_port: 22

# Keep inventory host keys stable. Set these per environment when the same
# logical inventory is deployed more than once.
platform_environment: prod
# Use either a prefix or suffix when you deploy the same logical inventory more
# than once. Do not include separators; they are added automatically.
# Example: ca-root-1 with prefix prod becomes prod-ca-root-1.
# Suffix is inserted before the numeric suffix, so ca-root-1 with suffix prod
# becomes ca-root-prod-1.
platform_hostname_prefix: ""
platform_hostname_suffix: ""
# Use a private internal subdomain, not the public website apex.
# Production usually uses the base private domain, such as corp.example.com or
# internal.example.com.
platform_domain: corp.example.com

# Keep hostname generation here so all.<env>.yml only has to override prefix,
# suffix, and domain values.
platform_hostname_prefix_normalized: >-
  {{
    (platform_hostname_prefix ~ '-')
    if platform_hostname_prefix | default('') | trim
    else ''
  }}
platform_hostname_suffix_normalized: >-
  {{
    ('-' ~ platform_hostname_suffix)
    if platform_hostname_suffix | default('') | trim
    else ''
  }}
platform_hostname: >-
  {{
    platform_hostname_prefix_normalized ~ (
      inventory_hostname
      | regex_replace('^(.*)-([0-9]+)$', '\1' ~ platform_hostname_suffix_normalized ~ '-\2')
      if platform_hostname_suffix
      else inventory_hostname
    )
  }}
platform_fqdn: "{{ platform_hostname }}.{{ platform_domain }}"

# Setup-specific group vars own platform_host_ips. Keep this file focused on
# the shared environment identity. When you add or uncomment a host, update the
# matching setup file, such as foundation.yml, edge.yml, or vault.yml.
# Environment-specific IPs belong in the matching <setup>.<env>.yml file.

# Baseline defaults applied by Ansible roles.
baseline_timezone: Europe/Stockholm
baseline_ntp_enabled: true
# IPv6 is disabled by default because this repo currently models IPv4-only
# guests. Set to false only for environments where IPv6 addressing, DNS,
# routing, and firewall rules are intentionally managed. External-facing paths
# can opt in later from their setup or environment vars.
baseline_disable_ipv6: true
# The baseline applies this with sysctl only so the same path works across
# Red Hat-family, Fedora, Debian, and Ubuntu templates.

# Repository proxy consumed by managed hosts. Uncomment after a cache/proxy
# exists and managed hosts should use it.
# This can cover OS package repos, Git remotes, and registry/update endpoints
# as policy allows. A setup can set repository_proxy_enabled: false to opt out.
# repository_proxy_enabled: true
# repository_proxy_fqdn: "cache.{{ platform_domain }}"
# repository_proxy_url: "http://{{ repository_proxy_fqdn }}:3128"
# repository_proxy_https_url defaults to repository_proxy_url when unset.
# repository_proxy_ip can stay unset when DNS resolves repository_proxy_fqdn.
# Set it only when the baseline must seed /etc/hosts before DNS exists.
# repository_proxy_ip: "<cache_proxy_vip>"

# Shell proxy exports are managed separately from package-manager proxying,
# but follow repository_proxy_enabled by default. This writes /etc/profile.d
# files so admin/user login shells can use the proxy without per-user bashrc
# edits. Uncomment only to override the default behavior.
# baseline_manage_shell_proxy: false
# shell_proxy_enabled: false
# shell_proxy_http_url: "{{ repository_proxy_url }}"
# shell_proxy_https_url defaults to shell_proxy_http_url when unset.
# shell_proxy_no_proxy_extra: []
