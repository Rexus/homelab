# Copy to: ansible/inventory/hosts.yml
# Replace every value before use.
# Setup guide: README.md

all:
  children:
    hypervisors:
      hosts:
        pve01-change-me:
          ansible_host: 10.10.10.11
    identity:
      hosts:
        foundation-identity-1-change-me:
          ansible_host: 10.10.12.10
        foundation-identity-2-change-me:
          ansible_host: 10.10.12.11
    pki_issuers:
      hosts:
        foundation-pki-1-change-me:
          ansible_host: 10.20.21.10
    pki_ceremony:
      hosts:
        foundation-ceremony-1-change-me:
          ansible_host: 10.20.22.10
    proxies:
      hosts:
        foundation-proxy-1-change-me:
          ansible_host: 10.30.30.10
    foundation:
      children:
        identity:
        pki_issuers:
        pki_ceremony:
        proxies:
    bootstrap:
      hosts:
        bootstrap01-change-me:
          ansible_host: 10.20.20.10
    vault:
      hosts:
        vault01-change-me:
          ansible_host: 10.10.10.21
    hsm_gateways:
      hosts:
        gateway01-change-me:
          ansible_host: 10.20.21.10
          hsm_proxy_ingress_backend_port: 8443
        gateway02-change-me:
          ansible_host: 10.20.21.11
          hsm_proxy_ingress_backend_port: 8443
    hsm_helpers:
      hosts:
        recovery01-change-me:
          ansible_host: 10.20.22.10
    guests:
      children:
        foundation:
        bootstrap:
        vault:
        hsm_gateways:
        hsm_helpers:
