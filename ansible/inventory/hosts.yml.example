# Copy to: ansible/inventory/hosts.yml
# Replace every value before use.
# Reference: docs/reference/infrastructure-automation-layout.md
#
# Keep these host keys stable and undecorated. Environment names are added as
# a prefix or suffix from ansible/group_vars/all.<env>.yml.
# Guest IP addresses live in platform_host_ips in setup group vars, not here.
#
# This is one shared inventory map. When you add or uncomment hosts here, also
# update the matching setup platform_host_ips entry and Terraform vm_instances.

all:
  vars:
    # Bootstrap connects by IP because DNS may not exist yet.
    ansible_host: >-
      {{
        platform_host_ips.get(inventory_hostname, inventory_hostname)
        if platform_host_ips is defined
        else inventory_hostname
      }}
  children:
    # Platform path: reference group for Proxmox host operations.
    # Guide: docs/platforms/proxmox/README.md
    # Foundation playbooks do not target Proxmox hosts.
    hypervisors:
      hosts: {}
      # To manage platform hosts with Ansible, remove "{}" above and add:
      # pve-1:
      #   ansible_host: 10.10.10.11

    # Shared private-domain path.
    # Guide: docs/paths/shared-services/identity.md
    # Terraform config: terraform/environments/foundation/terraform.tfvars
    identity_primary:
      hosts:
        # Exactly one host belongs here. The foundation playbook installs this
        # FreeIPA host first and verifies it before replicas are added.
        idm-1: {}
    identity_replicas:
      hosts:
        # Add more identity replicas here when you expand beyond the default pair.
        idm-2: {}
    identity:
      children:
        identity_primary:
        identity_replicas:
    issuing_ca:
      hosts:
        # Online issuing CA host in the cryptography network.
        ca-1: {}

    # Shared private-domain path: optional root CA host.
    # Guide: docs/paths/shared-services/identity.md
    root_ca:
      hosts: {}
      # If you add an offline root CA host, remove "{}" above and add it here.
      # Then add the same host to foundation vm_instances and foundation
      # platform_host_ips.
      # ca-root-1: {}

    # Edge load-balancer path.
    # Guide: docs/paths/shared-services/edge.md
    # Terraform config: terraform/environments/edge/terraform.tfvars
    edge_load_balancers:
      hosts:
        # Add edge-lb-3 and higher only after adding the same hosts to
        # edge vm_instances and edge platform_host_ips.
        edge-lb-1: {}
        edge-lb-2: {}

    # Cache path.
    # Guide: docs/paths/shared-services/cache.md
    # Terraform config: terraform/environments/cache/terraform.tfvars
    cache:
      hosts:
        # Add cache-3 and higher only after adding the same hosts to
        # cache vm_instances and cache platform_host_ips.
        cache-1: {}
        cache-2: {}

    foundation:
      children:
        identity:
        issuing_ca:
        root_ca:

    # Vault path.
    # Guide: docs/paths/shared-services/vault.md
    # Terraform config: terraform/environments/vault/terraform.tfvars
    vault:
      hosts:
        vault-1: {}

    # System control path: telemetry routing and enrichment.
    # Guide: docs/paths/system-control/observability.md
    # Terraform config: terraform/environments/observability/terraform.tfvars
    telemetry_gateways:
      hosts:
        telemetry-1: {}
      # If you uncomment telemetry-2, add it to observability vm_instances and
      # observability platform_host_ips.
      # telemetry-2: {}

    # System control path: hardened syslog and security event intake.
    # Guide: docs/paths/system-control/observability.md
    # Terraform config: terraform/environments/observability/terraform.tfvars
    security_telemetry:
      hosts:
        syslog-1: {}
      # If you uncomment syslog-2, add it to observability vm_instances and
      # observability platform_host_ips.
      # syslog-2: {}

    # System control path: dashboards, metrics, traces, and log backends.
    # Guide: docs/paths/system-control/observability.md
    # Terraform config: terraform/environments/observability/terraform.tfvars
    observability:
      hosts:
        health-1: {}
        metrics-1: {}
        apm-1: {}
        logs-1: {}
        telemetry-ui-1: {}
      # If you uncomment more OpenSearch hosts, add them to observability
      # vm_instances and observability platform_host_ips.
      # logs-2: {}
      # logs-3: {}

    # System control path: archive writer for cold log and snapshot targets.
    # Guide: docs/paths/system-control/observability.md
    # Terraform config: terraform/environments/observability/terraform.tfvars
    archive:
      hosts:
        archive-1: {}

    # Application platform path: Podman image runner.
    # Guide: docs/paths/application-platform/podman-runner.md
    # Terraform config: terraform/environments/podman-runner/terraform.tfvars
    podman_runner:
      hosts:
        runner-1: {}
      # If you uncomment runner-2, add it to podman-runner vm_instances and
      # podman_runner platform_host_ips.
      # runner-2: {}

    # Application platform path: development platform.
    # Guide: docs/paths/application-platform/development.md
    # Terraform config: terraform/environments/development/terraform.tfvars
    development_platform:
      hosts:
        git-1: {}

    # Application platform path: image-based Linux template builders.
    # Guide: docs/paths/application-platform/image-based-linux.md
    # Terraform config: terraform/environments/image-template/terraform.tfvars
    image_template_builders:
      hosts:
        # Use the target Proxmox template name as the host key. If you change
        # it, update image-template vm_instances and image_template
        # platform_host_ips too.
        rhel-10-immu-tmpl: {}

    # Proxmox platform path: mutable Enterprise Linux template refresh.
    # Guide: docs/platforms/proxmox/enterprise-linux-template.md
    # Terraform config: terraform/environments/template-refresh/terraform.tfvars
    template_refresh_builders:
      hosts:
        # Default is one staged replacement. Add more hosts only after adding
        # matching template-refresh vm_instances and template_refresh
        # platform_host_ips.
        alma-10-tmpl-stage: {}

    # Access path: identity provider hosts.
    # Guide: docs/architecture/network.md
    identity_providers:
      hosts: {}
      # If you add access-layer identity provider hosts, remove "{}" above and
      # add them here. Then add the same hosts to the matching Terraform setup
      # and the matching setup platform_host_ips.
      # idp-1: {}

    # Lab path.
    # Guide: docs/paths/private-cloud-maturity.md
    # Terraform config: terraform/environments/lab/terraform.tfvars
    lab:
      hosts:
        lab-1: {}
        support-1: {}

    # HSM path.
    # Guide: docs/security/usb-hsm-active-active-blueprint.md
    # Terraform config: terraform/environments/hsm/terraform.tfvars
    hsm_gateways:
      hosts:
        # hsm_proxy_ingress_backend_port is the service port exposed to the
        # edge load balancer, not a raw PKCS#11 or USB endpoint.
        hsm-1:
          hsm_proxy_ingress_backend_port: 8443
        hsm-2:
          hsm_proxy_ingress_backend_port: 8443

    # HSM path: cryptography administration helper.
    # Guide: docs/security/usb-hsm-active-active-blueprint.md
    crypto_admin:
      hosts: {}
      # Restricted ceremony or recovery host for cryptography and HSM work.
      # If you add a crypto administration host, remove "{}" above and add it
      # here. Then add the same host to hsm vm_instances and hsm
      # platform_host_ips.
      # crypto-admin-1: {}
    guests:
      children:
        foundation:
        edge_load_balancers:
        cache:
        identity_providers:
        vault:
        telemetry_gateways:
        security_telemetry:
        observability:
        archive:
        development_platform:
        podman_runner:
        image_template_builders:
        template_refresh_builders:
        lab:
        hsm_gateways:
        crypto_admin:
