# Copy to: ansible/inventory/hosts.yml
# Replace every value before use.
# Reference: docs/reference/infrastructure-automation-layout.md

all:
  children:
    hypervisors:
      hosts:
        pve01-change-me:
          ansible_host: 10.10.10.11
    identity_primary:
      hosts:
        identity-1: {}
    identity_replicas:
      hosts:
        identity-2: {}
    identity:
      children:
        identity_primary:
        identity_replicas:
    pki_issuers:
      hosts:
        pki-1: {}
    pki_ceremony:
      hosts: {}
      # When enabled, replace hosts: {} with:
      # hosts:
      #   ceremony-1: {}
    proxies:
      hosts: {}
      # When enabled, replace hosts: {} with:
      # hosts:
      #   proxy-1: {}
    foundation:
      children:
        identity:
        pki_issuers:
        pki_ceremony:
        proxies:
    vault:
      hosts:
        vault-1: {}
    lab:
      hosts:
        lab-1: {}
        support-1: {}
    hsm_gateways:
      hosts:
        hsm-gw-1:
          hsm_proxy_ingress_backend_port: 8443
        hsm-gw-2:
          hsm_proxy_ingress_backend_port: 8443
    hsm_helpers:
      hosts:
        hsm-recovery-1: {}
        # hsm-provisioner-1: {}
    guests:
      children:
        foundation:
        vault:
        lab:
        hsm_gateways:
        hsm_helpers:
