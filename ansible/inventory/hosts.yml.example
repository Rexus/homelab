# Copy to: ansible/inventory/hosts.yml
# Replace every value before use.
# Reference: docs/reference/infrastructure-automation-layout.md
#
# Keep these host keys stable and undecorated. Environment names are added as
# a prefix or suffix from ansible/group_vars/all.<env>.yml.
# Guest IP addresses live in platform_host_ips in group_vars, not here.

all:
  children:
    hypervisors:
      hosts: {}
      # Optional reference group for future Proxmox host operations.
      # The current foundation deployment does not run Ansible on Proxmox hosts.
      # When you need it later, remove "{}" above and add:
      # pve-1:
      #   ansible_host: 10.10.10.11
    identity_primary:
      hosts:
        # Exactly one host belongs here. The foundation playbook installs this
        # FreeIPA host first and verifies it before replicas are added.
        idm-1: {}
    identity_replicas:
      hosts:
        # Add more identity replicas here when you expand beyond the default pair.
        idm-2: {}
    identity:
      children:
        identity_primary:
        identity_replicas:
    issuing_ca:
      hosts:
        # Online issuing CA host in the cryptography network.
        ca-1: {}
    root_ca:
      hosts: {}
      # Optional offline root CA hosts in the ceremony network.
      # When enabled, remove "{}" above and add:
      # ca-root-1: {}
    identity_providers:
      hosts: {}
      # Optional access-layer identity provider hosts, such as Keycloak.
      # When enabled, remove "{}" above and add:
      # idp-1: {}
    edge_load_balancers:
      hosts: {}
      # Optional north-south ingress, egress, and load-balancer hosts.
      # When enabled, remove "{}" above and add:
      # edge-lb-1: {}
      # edge-lb-2: {}
    foundation:
      children:
        identity:
        issuing_ca:
        root_ca:
        edge_load_balancers:
    vault:
      hosts:
        # Vault is deployed after the identity foundation is ready.
        vault-1: {}
    lab:
      hosts:
        lab-1: {}
        support-1: {}
    hsm_gateways:
      hosts:
        # hsm_proxy_ingress_backend_port is the service port exposed to the
        # edge load balancer, not a raw PKCS#11 or USB endpoint.
        hsm-1:
          hsm_proxy_ingress_backend_port: 8443
        hsm-2:
          hsm_proxy_ingress_backend_port: 8443
    crypto_admin:
      hosts:
        # Restricted ceremony or recovery host for cryptography and HSM work.
        crypto-admin-1: {}
    guests:
      children:
        foundation:
        edge_load_balancers:
        identity_providers:
        vault:
        lab:
        hsm_gateways:
        crypto_admin:
