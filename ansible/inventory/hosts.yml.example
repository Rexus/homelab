# Copy to: ansible/inventory/hosts.yml
# Replace every value before use.
# Reference: docs/reference/infrastructure-automation-layout.md
#
# Keep these host keys stable and undecorated. Environment names are added as
# a prefix or suffix from ansible/group_vars/all.<env>.yml.
# Guest IP addresses live in platform_host_ips in group_vars, not here.

all:
  vars:
    # Bootstrap connects by IP because DNS may not exist yet.
    ansible_host: >-
      {{
        platform_host_ips.get(inventory_hostname, inventory_hostname)
        if platform_host_ips is defined
        else inventory_hostname
      }}
  children:
    # Platform path: reference group for Proxmox host operations.
    # The foundation deployment does not run Ansible on Proxmox hosts.
    hypervisors:
      hosts: {}
      # To manage platform hosts with Ansible, remove "{}" above and add:
      # pve-1:
      #   ansible_host: 10.10.10.11

    # Foundation identity path: default foundation run.
    identity_primary:
      hosts:
        # Exactly one host belongs here. The foundation playbook installs this
        # FreeIPA host first and verifies it before replicas are added.
        idm-1: {}
    identity_replicas:
      hosts:
        # Add more identity replicas here when you expand beyond the default pair.
        idm-2: {}
    identity:
      children:
        identity_primary:
        identity_replicas:
    issuing_ca:
      hosts:
        # Online issuing CA host in the cryptography network.
        ca-1: {}

    # Foundation ceremony path: root CA host.
    root_ca:
      hosts: {}
      # To deploy an offline root CA host, remove "{}" above and add:
      # ca-root-1: {}

    # Foundation edge path: north-south ingress, egress, and load balancing.
    edge_load_balancers:
      hosts: {}
      # To deploy edge load balancers, remove "{}" above and add:
      # edge-lb-1: {}
      # edge-lb-2: {}

    foundation:
      children:
        identity:
        issuing_ca:
        root_ca:
        edge_load_balancers:

    # Vault path.
    vault:
      hosts: {}
      # To deploy Vault, remove "{}" above and add:
      # vault-1: {}

    # Observability path: telemetry routing and enrichment.
    telemetry_gateways:
      hosts: {}
      # To deploy telemetry gateways, remove "{}" above and add:
      # telemetry-1: {}
      # telemetry-2: {}

    # Observability path: hardened syslog and security event intake.
    security_telemetry:
      hosts: {}
      # To deploy security telemetry collectors, remove "{}" above and add:
      # syslog-1: {}
      # syslog-2: {}

    # Observability path: dashboards, metrics, traces, and log backends.
    observability:
      hosts: {}
      # To deploy observability backends, remove "{}" above and add:
      # health-1: {}
      # metrics-1: {}
      # apm-1: {}
      # logs-1: {}
      # logs-2: {}
      # logs-3: {}
      # telemetry-ui-1: {}

    # Observability path: archive writer for cold log and snapshot targets.
    archive:
      hosts: {}
      # To deploy an archive writer, remove "{}" above and add:
      # archive-1: {}

    # Access path: identity provider hosts, such as Keycloak.
    identity_providers:
      hosts: {}
      # To deploy access-layer identity provider hosts, remove "{}" above and add:
      # idp-1: {}

    # Lab path.
    lab:
      hosts: {}
      # To deploy lab hosts, remove "{}" above and add:
      # lab-1: {}
      # support-1: {}

    # HSM path.
    hsm_gateways:
      hosts: {}
      # hsm_proxy_ingress_backend_port is the service port exposed to the
      # edge load balancer, not a raw PKCS#11 or USB endpoint.
      # To deploy HSM gateways, remove "{}" above and add:
      # hsm-1:
      #   hsm_proxy_ingress_backend_port: 8443
      # hsm-2:
      #   hsm_proxy_ingress_backend_port: 8443

    # Cryptography administration path.
    crypto_admin:
      hosts: {}
      # Restricted ceremony or recovery host for cryptography and HSM work.
      # To deploy a crypto administration host, remove "{}" above and add:
      # crypto-admin-1: {}
    guests:
      children:
        foundation:
        edge_load_balancers:
        identity_providers:
        vault:
        telemetry_gateways:
        security_telemetry:
        observability:
        archive:
        lab:
        hsm_gateways:
        crypto_admin:
