digraph Engineering {
graph [rankdir=LR,bgcolor="transparent",pad="0.2",nodesep="0.4",ranksep="0.8"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",margin="0.18,0.12"];
edge [fontname="Arial",fontsize=13,color="#627581",arrowsize="0.75"];
"UC-update" [label="«use case def»\nUC-update\nRetrieve and verify\nsoftware",fillcolor="#f8fafc",color="#64748b",fontcolor="#1f2937",shape="ellipse",URL="use-cases.svg",target="_top",id="model-UC-update"];
"F-admit" [label="«action»\nF-admit\nCheck request access",fillcolor="#fcebdc",color="#a16c43",fontcolor="#5b3921",shape="box",URL="function-views.svg#F-admit",target="_top",id="model-F-admit"];
"F-http" [label="«action»\nF-http\nFetch content from source",fillcolor="#fcebdc",color="#a16c43",fontcolor="#5b3921",shape="box",URL="function-views.svg#F-http",target="_top",id="model-F-http"];
"L-Proxy" [label="«part»\nL-Proxy\nPolicy proxy / HTTP cache",fillcolor="#fce8ec",color="#9b4d67",fontcolor="#502638",shape="box",URL="policy-proxy/contract.svg",target="_top",id="model-L-Proxy"];
"REQ-policy" [label="«requirement»\nREQ-policy\nadmittedSources",fillcolor="#f4dce9",color="#955076",fontcolor="#57253f",shape="box",URL="engineering.svg#REQ-policy",target="_top",id="model-REQ-policy"];
"VC-http-denied" [label="«verification def»\nVC-http-denied\nAssess HTTP admission\ndenial",fillcolor="#f8fafc",color="#64748b",fontcolor="#1f2937",shape="box",URL="../../generated/software-intake/verification-cases.md#vc-http-denied",target="_top",id="model-VC-http-denied"];
"F-admit" -> "L-Proxy" [label="allocate\nALLOC-F-admit-0",style=dashed];
"F-http" -> "L-Proxy" [label="allocate\nALLOC-F-http-0",style=dashed];
"L-Proxy" -> "REQ-policy" [label="satisfy\n(design assertion)\nSAT-policy",style=dashed];
"UC-update" -> "REQ-policy" [label="objective requires",style=dashed];
"VC-http-denied" -> "REQ-policy" [label="verify\n(test intent)",style=dashed];
}
