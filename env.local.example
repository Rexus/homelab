# Copy to: .env.local
# Replace every value before use.

# Terraform bpg/proxmox endpoint. Do not append /api2/json.
PROXMOX_API_URL=https://proxmox.example.com:8006/
PROXMOX_API_TOKEN_ID=automation@pve!provision
PROXMOX_API_TOKEN_SECRET=change-me

# Optional when you use encrypted Ansible Vault files.
# ANSIBLE_VAULT_PASSWORD_FILE=secrets/ansible-vault-password.txt
