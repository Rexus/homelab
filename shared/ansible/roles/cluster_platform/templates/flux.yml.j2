---
values:
  installCRDs: true
{% if cluster_platform_management == 'flux' %}
  multitenancy:
    enabled: true
    defaultServiceAccount: default
    privileged: true
{% endif %}
  imageAutomationController:
    create: false
  imageReflectionController:
    create: false
  sourceController:
    create: true
  kustomizeController:
    create: true
  helmController:
    create: true
  notificationController:
    create: true
required_secrets:
  - name: {{ cluster_platform_flux_git_secret | to_json }}
    keys: {{ cluster_platform_flux_git_secret_keys | to_json }}
  - name: {{ cluster_platform_flux_age_secret | to_json }}
    keys: [{{ cluster_platform_flux_age_key | to_json }}]
{% if cluster_platform_management == 'flux' %}
  - name: {{ cluster_platform_flux_platform_git_secret | to_json }}
    keys: {{ cluster_platform_flux_platform_git_secret_keys | to_json }}
  - name: {{ cluster_platform_flux_platform_age_secret | to_json }}
    keys: [{{ cluster_platform_flux_age_key | to_json }}]
  - name: {{ cluster_platform_flux_application_git_secret | to_json }}
    keys: {{ cluster_platform_flux_application_git_secret_keys | to_json }}
  - name: {{ cluster_platform_flux_application_age_secret | to_json }}
    keys: [{{ cluster_platform_flux_age_key | to_json }}]
{% endif %}
{% if cluster_platform_management == 'flux' %}
before:
  - apiVersion: v1
    kind: ServiceAccount
    metadata: {name: platform-reconciler, namespace: flux-system}
    automountServiceAccountToken: false
  - apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata: {name: tier1-platform-reconciler}
    roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: cluster-admin}
    subjects:
      - {kind: ServiceAccount, name: platform-reconciler, namespace: flux-system}
{% endif %}
after:
  - apiVersion: source.toolkit.fluxcd.io/v1
    kind: GitRepository
    metadata:
      name: platform
      namespace: flux-system
    spec:
      interval: 1m
      url: {{ cluster_platform_flux_url | to_json }}
      ref:
        commit: {{ cluster_platform_flux_commit | to_json }}
      secretRef:
        name: {{ cluster_platform_flux_git_secret | to_json }}
  - apiVersion: kustomize.toolkit.fluxcd.io/v1
    kind: Kustomization
    metadata:
      name: platform
      namespace: flux-system
    spec:
      interval: 5m
      retryInterval: 1m
      timeout: 5m
{% if cluster_platform_management == 'flux' %}
      serviceAccountName: platform-reconciler
{% endif %}
      path: {{ cluster_platform_flux_path | to_json }}
      prune: false
      wait: true
      sourceRef:
        kind: GitRepository
        name: platform
      decryption:
        provider: sops
        secretRef:
          name: {{ cluster_platform_flux_age_secret | to_json }}
{% if cluster_platform_management == 'flux' %}
{{ lookup('ansible.builtin.template', 'tier1-sources.yml.j2') }}
{% endif %}
