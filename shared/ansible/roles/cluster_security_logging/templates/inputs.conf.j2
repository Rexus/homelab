# Raw JSON lines remain in log; do not discard audit fields during normalization.
[INPUT]
    Name tcp
    Alias talos-system
    Tag talos.system
    Listen 127.0.0.1
    Port {{ cluster_security_logging_listener_port }}
    Format none
    Buffer_Size 32
    Chunk_Size 32
    storage.type filesystem

{% if security_logging_node.control_plane %}
[INPUT]
    Name tail
    Alias kubernetes-audit
    Tag kube.audit
    Path /var/log/audit/kube/kube-apiserver*.log
    Key log
    Path_Key source_file
    DB /buffers/audit.db
    DB.Sync Full
    DB.Locking true
    Read_from_Head true
    Refresh_Interval 5
    Rotate_Wait 30
    Buffer_Chunk_Size 32768
    Buffer_Max_Size 32768
    Skip_Long_Lines On
    storage.type filesystem
{% endif %}

[INPUT]
    Name tail
    Alias kubernetes-pods
    Tag kube.pods
    Path /var/log/containers/*.log
    Exclude_Path /var/log/containers/security-log-*_{{ cluster_security_logging_namespace }}_*.log
    Key log
    Path_Key source_file
    DB /buffers/pods.db
    DB.Sync Full
    DB.Locking true
    Read_from_Head true
    Refresh_Interval 5
    Rotate_Wait 30
    Buffer_Chunk_Size 32768
    Buffer_Max_Size 32768
    Skip_Long_Lines On
    storage.type filesystem
