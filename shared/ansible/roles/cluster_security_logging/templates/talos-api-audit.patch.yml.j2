{% if cluster_security_logging_talos_schema == 'v1.14' %}
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  omitStages: [RequestReceived]
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
extraArgs:
  audit-log-path: /var/log/audit/kube/kube-apiserver.log
  audit-log-maxage: "30"
  audit-log-maxbackup: "10"
  audit-log-maxsize: "100"
{% else %}
cluster:
  apiServer:
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      omitStages: [RequestReceived]
      rules:
        - level: Metadata
    extraArgs:
      audit-log-path: /var/log/audit/kube/kube-apiserver.log
      audit-log-maxage: "30"
      audit-log-maxbackup: "10"
      audit-log-maxsize: "100"
{% endif %}
