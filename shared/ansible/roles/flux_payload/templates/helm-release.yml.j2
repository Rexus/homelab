- apiVersion: helm.toolkit.fluxcd.io/v2
  kind: HelmRelease
  metadata: {name: {{ identity }}, namespace: {{ flux_payload_namespace }}}
  spec:
    interval: 5m
    timeout: {{ release.timeout | default('20m') }}
    releaseName: {{ release.name }}
    targetNamespace: {{ release.namespace }}
    storageNamespace: {{ release.namespace }}
    serviceAccountName: {{ flux_payload_service_account }}
    maxHistory: 5
    driftDetection: {mode: enabled}
    chart:
      spec:
        chart: {{ release.chart | to_json }}
        version: {{ release.version | to_json }}
        sourceRef:
          kind: HelmRepository
          name: {{ identity }}
          namespace: {{ flux_payload_namespace }}
    valuesFrom:
      - kind: Secret
        name: {{ identity }}-values
        valuesKey: values.yaml
    postRenderers:
      - kustomize:
          patches:
            - target: {version: v1, kind: PersistentVolumeClaim}
              patch: |
                apiVersion: v1
                kind: PersistentVolumeClaim
                metadata:
                  name: retained-claims
                  annotations:
                    helm.sh/resource-policy: keep
                    kustomize.toolkit.fluxcd.io/prune: disabled
    # Failed stateful upgrades require an explicit operator decision.
    install:
      disableWait: {{ release.disable_wait | default(false) | bool | lower }}
      remediation: {retries: 0}
    upgrade:
      disableWait: {{ release.disable_wait | default(false) | bool | lower }}
      cleanupOnFail: false
      remediation: {retries: 0}
