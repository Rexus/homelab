{% set revision = (lookup('ansible.builtin.template', 'job-spec.yml.j2') ~
                   lookup('ansible.builtin.template', 'backup.sh.j2') ~
                   postgresql_file_backup_target.volume_handle) | hash('sha256') %}
apiVersion: v1
kind: ConfigMap
metadata: {name: {{ postgresql_file_backup_target.cluster }}-files, namespace: {{ postgresql_file_backup_target.namespace }}}
data:
  backup.sh: |
{{ lookup('ansible.builtin.template', 'backup.sh.j2') | indent(4, true) }}
---
apiVersion: batch/v1
kind: CronJob
metadata: {name: {{ postgresql_file_backup_target.cluster }}-files, namespace: {{ postgresql_file_backup_target.namespace }}}
spec:
  schedule: {{ postgresql_file_backup_target.schedule | to_json }}
  timeZone: UTC
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 600
  successfulJobsHistoryLimit: 2
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
{{ lookup('ansible.builtin.template', 'job-spec.yml.j2') | indent(6, true) }}
---
apiVersion: batch/v1
kind: Job
metadata: {name: {{ postgresql_file_backup_target.cluster }}-files-first-{{ revision[:10] }}, namespace: {{ postgresql_file_backup_target.namespace }}}
spec:
{{ lookup('ansible.builtin.template', 'job-spec.yml.j2') | indent(2, true) }}
