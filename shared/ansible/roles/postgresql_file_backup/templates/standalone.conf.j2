data_directory = '/work/pgdata'
hba_file = '/recovery/pg_hba.conf'
ident_file = '/recovery/pg_ident.conf'
listen_addresses = '*'
port = 5432
unix_socket_directories = '/tmp'
ssl = on
ssl_cert_file = '/server/tls.crt'
ssl_key_file = '/server/tls.key'
ssl_ca_file = '/client-ca/ca.crt'
wal_level = replica
hot_standby = off
max_wal_senders = 4
max_replication_slots = 4
archive_mode = off
archive_command = ''
restore_command = ''
primary_conninfo = ''
primary_slot_name = ''
synchronous_standby_names = ''
logging_collector = off
