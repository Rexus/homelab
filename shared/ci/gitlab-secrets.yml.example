# Include from a reviewed local checkout of Shared, or pin the include project/ref.
# Guide: docs/development/secret-scanning.md
secret-scan:
  stage: .pre
  inherit:
    default: false
    variables: false
  tags: [tier1-build]
  image:
    name: ghcr.io/gitleaks/gitleaks:v8.30.1
    entrypoint: ['']
  variables:
    GIT_DEPTH: '0'
  script:
    - gitleaks git --redact --ignore-gitleaks-allow --log-opts=--all
  allow_failure: false
  # No raw findings, plans, state or credentials are published as artifacts.
