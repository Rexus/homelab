# Copy to: terraform/environments/bootstrap/terraform.tfvars
# Replace every value before use.
# Setup guide: README.md
# Shared values live in ../../common.tfvars.

cluster_name = "bootstrap-change-me"

vm_instances = {
  bootstrap01 = {
    name             = "bootstrap01-change-me"
    node_name        = "pve01-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "application"
    ipv4_address     = "dhcp"
    role             = "bootstrap"
  }
}

lxc_instances = {
  support01 = {
    name             = "container-01-change-me"
    node_name        = "pve01-change-me"
    template_file_id = "local:vztmpl/el10-default_2024.x86_64.tar.xz"
    size             = "tiny"
    storage_class    = "local"
    disk_size_gb     = 8
    network_zone_key = "application"
    ipv4_address     = "dhcp"
    role             = "support"
  }
}
