# Copy to: terraform/environments/cache/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/paths/shared-services/cache.md
# Shared values live in ../../common.tfvars.

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  # The default is a pair. Add cache-3 and higher when you need horizontal
  # scale, and keep matching Ansible inventory and IP entries.
  "cache-1" = {
    vm_id            = 230
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    # Dedicated Squid cache disk mounted by Ansible at /var/spool/squid.
    extra_disks = [
      {
        interface     = "scsi1"
        size_gb       = 100
        storage_class = "local"
      }
    ]
    network_zone_key = "external_edge"
    tags             = ["squid", "keepalived", "restricted", "always-on", "platform"]
  }
  "cache-2" = {
    vm_id            = 231
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    extra_disks = [
      {
        interface     = "scsi1"
        size_gb       = 100
        storage_class = "local"
      }
    ]
    network_zone_key = "external_edge"
    tags             = ["squid", "keepalived", "restricted", "always-on", "platform"]
  }
  # "cache-3" = {
  #   vm_id            = 232
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 30
  #   extra_disks = [
  #     {
  #       interface     = "scsi1"
  #       size_gb       = 100
  #       storage_class = "local"
  #     }
  #   ]
  #   network_zone_key = "external_edge"
  #   tags             = ["squid", "keepalived", "restricted", "always-on", "platform"]
  # }
}

lxc_instances = {}
