# Copy to: terraform/environments/development/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/paths/application-platform/development.md
# Shared values live in ../../common.tfvars.

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

vm_instances = {
  # Default first development platform: one GitLab host on Podman.
  # Keep the host key aligned with ansible/inventory/hosts.yml and
  # ansible/group_vars/development.yml.
  "git-1" = {
    vm_id            = 300
    size             = "xl"
    storage_class    = "shared"
    disk_size_gb     = 200
    network_zone_key = "application"
    tags             = ["gitlab", "podman", "internal", "always-on", "apps"]
  }
}

lxc_instances = {}
