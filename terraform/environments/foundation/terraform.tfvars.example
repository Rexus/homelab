# Copy to: terraform/environments/foundation/terraform.tfvars
# Or copy to terraform.test.tfvars / terraform.prod.tfvars when using --env.
# Replace every value before use.
# Setup guide: docs/foundation/identity-foundation-path.md
# Shared values live in ../../common.tfvars.

cluster_name = "test-change-me"

vm_instances = {
  # Keys match Ansible inventory hosts. Identity, IP, and tags live there.
  "test-identity-1.ipa.example.com" = {
    node_name        = "pve01-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "identity"
  }
  "test-identity-2.ipa.example.com" = {
    node_name        = "pve02-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "identity"
  }
  "test-pki-1-change-me" = {
    node_name        = "pve01-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "cryptography"
  }
  # "test-ceremony-1-change-me" = {
  #   node_name        = "pve01-change-me"
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 30
  #   network_zone_key = "ceremony"
  # }
  # "test-proxy-1-change-me" = {
  #   node_name        = "pve01-change-me"
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 20
  #   network_zone_key = "external_ingress"
  # }
}

lxc_instances = {}
