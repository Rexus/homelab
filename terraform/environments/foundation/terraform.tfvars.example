# Copy to: terraform/environments/foundation/terraform.tfvars
# Optionally copy to terraform.<env>.tfvars only for environment overrides.
# Replace every value before use.
# Setup guide: docs/paths/shared-services/identity.md
# Shared values live in ../../common.tfvars.

cluster_name = "foundation-change-me"

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  "idm-1" = {
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 111
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "identity"
    tags              = ["freeipa", "dns"]
  }
  "idm-2" = {
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "identity"
    tags              = ["freeipa", "dns"]
  }
  "ca-1" = {
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 30
    network_zone_key  = "cryptography"
    tags              = ["issuing-ca"]
  }
  # "ca-root-1" = {
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 30
  #   network_zone_key  = "ceremony"
  #   tags              = ["root-ca", "offline"]
  # }
  # "edge-lb-1" = {
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 20
  #   network_zone_key  = "external_edge"
  #   tags              = ["edge-lb"]
  # }
  # "edge-lb-2" = {
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 20
  #   network_zone_key  = "external_edge"
  #   tags              = ["edge-lb"]
  # }
}

lxc_instances = {}
