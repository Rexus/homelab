# Copy to: terraform/environments/foundation/terraform.tfvars
# Optionally copy to terraform.<env>.tfvars only for environment overrides.
# Replace every value before use.
# Setup guide: docs/foundation/identity-foundation-path.md
# Shared values live in ../../common.tfvars.

cluster_name = "foundation-change-me"

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix from Ansible group vars becomes the Proxmox VM name.
  "identity-1" = {
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "identity"
    tags              = ["freeipa", "dns"]
  }
  "identity-2" = {
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "identity"
    tags              = ["freeipa", "dns"]
  }
  "pki-1" = {
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 30
    network_zone_key  = "cryptography"
    tags              = ["issuing-ca"]
  }
  # "ceremony-1" = {
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 30
  #   network_zone_key  = "ceremony"
  #   tags              = ["root-ca", "offline"]
  # }
  # "proxy-1" = {
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 20
  #   network_zone_key  = "external_ingress"
  #   tags              = ["shared-ingress"]
  # }
}

lxc_instances = {}
