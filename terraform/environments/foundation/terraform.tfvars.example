# Copy to: terraform/environments/foundation/terraform.tfvars
# Or copy to terraform.test.tfvars / terraform.prod.tfvars when using --env.
# Replace every value before use.
# Setup guide: README.md

platform = "proxmox"
cluster_name = "test-change-me"

proxmox_storage_classes = {
  local = {
    vm_disk        = "local-lvm-change-me"
    initialization = "local-lvm-change-me"
  }
  shared = {
    vm_disk        = "shared-change-me"
    initialization = "shared-change-me"
  }
  fast = {
    vm_disk        = "nvme-change-me"
    initialization = "local-lvm-change-me"
  }
}

network_zones = {
  management = {
    description = "Operator, IaC, and hypervisor-adjacent access."
    bridge      = "vmbr0"
    vlan_id     = 10
    cidr_ipv4   = "10.10.10.0/24"
  }
  access = {
    description = "SSO, Keycloak, and controlled user access services."
    bridge      = "vmbr0"
    vlan_id     = 11
    cidr_ipv4   = "10.10.11.0/24"
  }
  identity = {
    description = "FreeIPA, DNS, and identity services."
    bridge      = "vmbr0"
    vlan_id     = 12
    cidr_ipv4   = "10.10.12.0/24"
  }
  corosync = {
    description = "Optional Proxmox cluster control network."
    bridge      = "vmbr1"
    vlan_id     = 20
    cidr_ipv4   = "10.10.20.0/24"
    notes       = "Reference zone for clustered control-plane traffic."
  }
  ceph_public = {
    description = "Optional Ceph client-facing network."
    bridge      = "vmbr1"
    vlan_id     = 21
    cidr_ipv4   = "10.10.21.0/24"
    notes       = "Reference zone only until you run Ceph."
  }
  ceph_cluster = {
    description = "Optional Ceph replication and recovery network."
    bridge      = "vmbr1"
    vlan_id     = 22
    cidr_ipv4   = "10.10.22.0/24"
    notes       = "Reference zone only until you run Ceph."
  }
  application = {
    description = "Internal application traffic and shared application consumers."
    bridge      = "vmbr0"
    vlan_id     = 120
    cidr_ipv4   = "10.20.20.0/24"
  }
  cryptography = {
    description = "Live cryptography, issuing CA, and HSM-backed gateway traffic."
    bridge      = "vmbr0"
    vlan_id     = 220
    cidr_ipv4   = "10.20.21.0/24"
    notes       = "Use this for the online issuing CA now and for later HSM-backed services when needed."
  }
  ceremony = {
    description = "Restricted ceremony, provisioning, recovery, or root-CA path."
    bridge      = "vmbr0"
    vlan_id     = 221
    cidr_ipv4   = "10.20.22.0/24"
    notes       = "Use this for an offline root CA host when you keep that system powered off outside planned ceremonies."
  }
  dmz = {
    description = "Edge or ingress-facing services."
    bridge      = "vmbr0"
    vlan_id     = 320
    cidr_ipv4   = "10.30.30.0/24"
  }
}

template_vm_id_el10 = 110
ssh_public_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGExamplePublicKeyMaterialChangeMe automation@foundation"
]

vm_instances = {
  # Place the two identity hosts on different nodes when the platform allows it.
  identity01 = {
    name             = "test-identity-1-change-me"
    node_name        = "pve01-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "identity"
    ipv4_address     = "dhcp"
    role             = "identity"
    tags             = ["freeipa", "dns"]
  }
  identity02 = {
    name             = "test-identity-2-change-me"
    node_name        = "pve02-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "identity"
    ipv4_address     = "dhcp"
    role             = "identity"
    tags             = ["freeipa", "dns"]
  }
  issuingca01 = {
    name             = "test-pki-1-change-me"
    node_name        = "pve01-change-me"
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "cryptography"
    ipv4_address     = "dhcp"
    role             = "pki"
    tags             = ["issuing-ca"]
  }
  # rootca01 = {
  #   name             = "test-ceremony-1-change-me"
  #   node_name        = "pve01-change-me"
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 30
  #   network_zone_key = "ceremony"
  #   ipv4_address     = "dhcp"
  #   role             = "ceremony"
  #   tags             = ["root-ca", "offline"]
  # }
  # proxy01 = {
  #   name             = "test-proxy-1-change-me"
  #   node_name        = "pve01-change-me"
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 20
  #   network_zone_key = "dmz"
  #   ipv4_address     = "dhcp"
  #   role             = "proxy"
  #   tags             = ["shared-ingress"]
  # }
}

lxc_instances = {}
