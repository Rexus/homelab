# Copy to: terraform/environments/hsm-lab/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/security/usb-hsm-active-active-blueprint.md
# Shared values live in ../../common.tfvars.

cluster_name = "hsm-lab-change-me"
lab_variant = "hardware"

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

# Keep the shared external ingress edge proxy in terraform/environments/foundation by default.
# Keys match the stable logical host names in the Ansible inventory.
# The environment prefix from Ansible group vars becomes the Proxmox VM name.
# The repository reference shape is one edge proxy in foundation plus two
# gateway hosts here, each with its own local USB HSM.
vm_instances = {
  "hsm-gw-1" = {
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 111
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "cryptography"
    tags             = ["hsm-gateway"]
  }
  "hsm-gw-2" = {
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "cryptography"
    tags             = ["hsm-gateway"]
  }
  # "hsm-recovery-1" = {
  #   size             = "tiny"
  #   storage_class    = "local"
  #   disk_size_gb     = 20
  #   network_zone_key = "ceremony"
  #   tags             = ["recovery"]
  # }
  # "hsm-provisioner-1" = {
  #   size             = "tiny"
  #   storage_class    = "local"
  #   disk_size_gb     = 20
  #   network_zone_key = "ceremony"
  #   tags             = ["provisioning"]
  # }
}

lxc_instances = {}
