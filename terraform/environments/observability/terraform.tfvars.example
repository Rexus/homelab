# Copy to: terraform/environments/observability/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/paths/system-control/observability.md
# Shared values live in ../../common.tfvars.

cluster_name = "observability-change-me"

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  "telemetry-1" = {
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "telemetry_gateway"
    tags             = ["otel-collector"]
  }
  # "telemetry-2" = {
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 40
  #   network_zone_key = "telemetry_gateway"
  #   tags             = ["otel-collector"]
  # }
  "syslog-1" = {
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 100
    network_zone_key = "security_telemetry"
    tags             = ["syslog", "security-events"]
  }
  # "syslog-2" = {
  #   size             = "small"
  #   storage_class    = "local"
  #   disk_size_gb     = 100
  #   network_zone_key = "security_telemetry"
  #   tags             = ["syslog", "security-events"]
  # }
  "health-1" = {
    size             = "medium"
    storage_class    = "local"
    disk_size_gb     = 100
    network_zone_key = "observability"
    tags             = ["netdata"]
  }
  "metrics-1" = {
    size             = "large"
    storage_class    = "shared"
    disk_size_gb     = 500
    network_zone_key = "observability"
    tags             = ["victoriametrics"]
  }
  "apm-1" = {
    size             = "large"
    storage_class    = "shared"
    disk_size_gb     = 1000
    network_zone_key = "observability"
    tags             = ["signoz", "clickhouse"]
  }
  "logs-1" = {
    size             = "large"
    storage_class    = "shared"
    disk_size_gb     = 1000
    network_zone_key = "observability"
    tags             = ["opensearch"]
  }
  # "logs-2" = {
  #   size             = "large"
  #   storage_class    = "shared"
  #   disk_size_gb     = 1000
  #   network_zone_key = "observability"
  #   tags             = ["opensearch"]
  # }
  # "logs-3" = {
  #   size             = "large"
  #   storage_class    = "shared"
  #   disk_size_gb     = 1000
  #   network_zone_key = "observability"
  #   tags             = ["opensearch"]
  # }
  "telemetry-ui-1" = {
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "observability"
    tags             = ["dashboard", "sso-entry"]
  }
  "archive-1" = {
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "storage"
    tags             = ["archive"]
  }
}

lxc_instances = {}
