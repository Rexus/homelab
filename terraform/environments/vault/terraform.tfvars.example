# Copy to: terraform/environments/vault/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/foundation/vault-foundation-deployment.md
# Shared values live in ../../common.tfvars.

cluster_name = "vault-change-me"

vm_instances = {
  # Keys match Ansible inventory hosts. Identity, IP, and tags live there.
  "vault01-change-me" = {
    node_name        = "pve01-change-me"
    size             = "large"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "application"
  }
}

# Keep Vault VM-only unless you have a specific helper-container use case.
lxc_instances = {}
