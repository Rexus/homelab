# Copy to: terraform/environments/vault/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/foundation/vault-foundation-deployment.md
# Shared values live in ../../common.tfvars.

cluster_name = "vault-change-me"

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix from Ansible group vars becomes the Proxmox VM name.
  "vault-1" = {
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 111
    size             = "large"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "application"
    tags             = ["vault"]
  }
}

# Keep Vault VM-only unless you have a specific helper-container use case.
lxc_instances = {}
