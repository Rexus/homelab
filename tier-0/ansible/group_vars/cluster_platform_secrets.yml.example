---
# Copy privately and encrypt with ansible-vault before supplying real values.
# Use only for explicitly owned bootstrap credentials; never commit plaintext keys.
cluster_platform_manage_secrets: true
cluster_platform_secrets:
  flux-system/flux-git:
    username: REPLACE_WITH_READ_ONLY_GIT_USERNAME
    password: REPLACE_WITH_INDEPENDENT_READ_ONLY_GIT_TOKEN
  # For SSH replace the entry above with identity, identity.pub and known_hosts.
  flux-system/sops-age:
    age.agekey: REPLACE_WITH_PRIVATE_AGE_IDENTITY
