---
# Optional private bootstrap input: copy, edit and encrypt with ansible-vault.
# Existing Secret ownership is the default. Add one entry per node; never a CA signing key.
cluster_security_logging_manage_secrets: true
cluster_security_logging_secrets:
  security-logging/control-k8ctl-1-tls:
    ca.crt: REPLACE_WITH_PUBLIC_RECEIVER_AND_CLIENT_CA_BUNDLE_PEM
    tls.crt: REPLACE_WITH_ENROLLED_NODE_CLIENT_LEAF_CHAIN_PEM
    tls.key: REPLACE_WITH_MATCHING_NODE_CLIENT_PRIVATE_KEY_PEM
