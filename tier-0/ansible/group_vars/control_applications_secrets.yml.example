---
# Private controller inputs only. Encrypt the real file with Ansible Vault and pass -e @path.
# Keep manage_secrets=false when a pre-existing secret controller owns these objects.
control_applications_manage_secrets: false
control_applications_keycloak_auth:
  auth_realm: master
  auth_username: ""
  auth_password: ""
control_applications_ldap_bind_password: ""
control_applications_oidc_client_secrets: {vault: "", netbox: "", headlamp: ""}
control_applications_vault_token: ""
# namespace/name -> stringData. Every required key is listed in the rendered release contract.
# Supply only selected products; do not put live values in this public example.
control_applications_secrets:
  keycloak/keycloak-bootstrap: {username: "", password: ""}
  keycloak/keycloak-db: {username: keycloak, password: ""}
  keycloak/freeipa-ca: {ca.crt: ""}
  keycloak/keycloak-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  keycloak/keycloak-db-ca: {ca.crt: ""}
  keycloak/keycloak-db-server: {tls.crt: "", tls.key: ""}
  keycloak/keycloak-db-replication: {tls.crt: "", tls.key: ""}
  keycloak/keycloak-db-backup: {ACCESS_KEY_ID: "", ACCESS_SECRET_KEY: "", ca.crt: ""}
  vault/vault-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  netbox/netbox-db: {username: netbox, password: ""}
  netbox/netbox-db-ca: {ca.crt: ""}
  netbox/netbox-db-server: {tls.crt: "", tls.key: ""}
  netbox/netbox-db-replication: {tls.crt: "", tls.key: ""}
  netbox/netbox-db-backup: {ACCESS_KEY_ID: "", ACCESS_SECRET_KEY: "", ca.crt: ""}
  netbox/netbox-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  netbox/service-ca: {ca.crt: ""}
  netbox/netbox-config: {secret_key: "", api_token_peppers: ""}
  netbox/netbox-superuser: {username: recovery-admin, password: "", email: "", api_token: ""}
  netbox/netbox-oidc:
    oidc.yaml: |
      SOCIAL_AUTH_OIDC_SECRET: ""
  netbox/netbox-cache:
    password: ""
    # requirepass must match password above; supply an operator-held strong credential.
    valkey.conf: |
      bind 0.0.0.0
      protected-mode yes
      port 0
      tls-port 6379
      tls-cert-file /tls/tls.crt
      tls-key-file /tls/tls.key
      tls-ca-cert-file /tls/ca.crt
      tls-auth-clients no
      requirepass REPLACE_WITH_THE_SAME_PRIVATE_PASSWORD
      dir /data
      appendonly yes
      maxmemory 384mb
      maxmemory-policy noeviction
  netbox/netbox-cache-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  headlamp/headlamp-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  headlamp/service-ca: {ca.crt: ""}
  headlamp/headlamp-oidc:
    OIDC_CLIENT_ID: headlamp
    OIDC_CLIENT_SECRET: ""
    OIDC_ISSUER_URL: ""
    OIDC_SCOPES: openid,profile,email,groups
