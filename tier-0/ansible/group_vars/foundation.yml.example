# Copy to: ansible/group_vars/foundation.yml
# Replace every value before use.
# Keep this file plain YAML: Terraform also reads the host IPs.
# Secret inputs: docs/administration/secret-handling/ansible-vault.md

platform_host_ips:
  idm-1: 10.10.12.10
  idm-2: 10.10.12.11
  ca-1: 10.20.21.10

foundation_freeipa_enabled: true
# Existing internally rooted installations remain unchanged. For the sibling-CA
# reference select external, run csr, sign offline, then select complete.
foundation_freeipa_ca_mode: internal
foundation_freeipa_external_phase: csr
foundation_freeipa_external_cert_files: []
foundation_freeipa_csr_directory: "{{ inventory_dir }}/../../secrets/identity"

# Bootstrap SSH waits are intentionally setup-owned so first-run timing can be
# tuned without changing global Ansible SSH behavior.
foundation_ssh_wait_timeout: 90
foundation_ssh_wait_sleep: 3
foundation_connection_connect_timeout: 8
foundation_connection_wait_retries: 10
foundation_connection_wait_delay: 3

# FreeIPA uses the platform domain by default. Override only if your identity
# domain intentionally differs from the environment domain.
foundation_freeipa_domain: "{{ platform_domain }}"
foundation_freeipa_realm: "{{ platform_domain | upper }}"

# Inject secrets on the controller; never encrypt this shared inventory input.
# An encrypted secret-only override is supported during --ansible-only execution.
foundation_freeipa_dm_password: "{{ lookup('ansible.builtin.env', 'FREEIPA_DM_PASSWORD') | default('change-me', true) }}"
foundation_freeipa_admin_password: "{{ lookup('ansible.builtin.env', 'FREEIPA_ADMIN_PASSWORD') | default('change-me', true) }}"

# Keep DNS enabled for the default identity foundation. Set explicit forwarders
# only when you do not want FreeIPA to discover them automatically.
foundation_freeipa_setup_dns: true
foundation_freeipa_auto_forwarders: true
foundation_freeipa_dns_forwarders: []
foundation_freeipa_allow_zone_overlap: false
foundation_freeipa_setup_firewalld: true

# These map into the freeipa.ansible_freeipa collection roles.
ipaserver_domain: "{{ foundation_freeipa_domain }}"
ipaserver_realm: "{{ foundation_freeipa_realm }}"
ipaserver_setup_dns: "{{ foundation_freeipa_setup_dns }}"
ipaserver_auto_forwarders: "{{ foundation_freeipa_auto_forwarders }}"
ipaserver_forwarders: "{{ foundation_freeipa_dns_forwarders }}"
ipaserver_allow_zone_overlap: "{{ foundation_freeipa_allow_zone_overlap }}"
ipaserver_setup_firewalld: "{{ foundation_freeipa_setup_firewalld }}"
ipaserver_hostname: "{{ platform_fqdn }}"
ipaadmin_password: "{{ foundation_freeipa_admin_password }}"
ipadm_password: "{{ foundation_freeipa_dm_password }}"

ipareplica_domain: "{{ foundation_freeipa_domain }}"
ipareplica_realm: "{{ foundation_freeipa_realm }}"
ipareplica_setup_dns: "{{ foundation_freeipa_setup_dns }}"
ipareplica_setup_ca: true
ipareplica_setup_firewalld: "{{ foundation_freeipa_setup_firewalld }}"
ipareplica_hostname: "{{ platform_fqdn }}"
ipareplica_servers: >-
  {{ groups.get('identity_primary', [])
    | map('extract', hostvars, 'platform_fqdn')
    | list }}
