# Copy to ansible/group_vars/hsm.yml and pass with --ansible-vars.
# Schema/defaults: ansible/roles/hsm_provider/defaults/main.yml
# Guide: docs/03-deployment/stage-3-trust/step-1b-usb-hsm.md

platform_host_ips:
  # Capacity-sized Tier 0 service pool; any VIP/proxy is co-hosted here.
  hsm-1: 10.20.21.20
  hsm-2: 10.20.21.21
  # hsm-3: 10.20.21.22
  # cadm-1: 10.20.22.20

# Approved SDK packages must be available through baseline's selected package sources.
# Package names and library paths depend on the selected SDK, OS and CPU architecture.
hsm_provider: yubihsm2
hsm_provider_custody_ready: false  # True only after factory credential change and approved recovery custody.
hsm_provider_mode: usb
hsm_provider_packages: [yubihsm-connector, yubihsm-pkcs11]
hsm_provider_library: /usr/lib/x86_64-linux-gnu/pkcs11/yubihsm_pkcs11.so
# Add per-device values in inventory host entries or host_vars/<host>.yml:
# hsm_yubihsm_serial: "REPLACE_WITH_DEVICE_SERIAL"
# hsm_provider_expected_serial: "REPLACE_WITH_PKCS11_REPORTED_SERIAL"
# Serials identify devices; no PIN/default credential is used for listing.

# Single USB OpenSC/Pico HSM on the existing issuer:
# hsm_provider: picohsm
# hsm_provider_packages: [opensc]
# hsm_provider_library: /usr/lib/x86_64-linux-gnu/opensc-pkcs11.so
# hsm_provider_pcsc_readers: [REPLACE_WITH_EXACT_ACCEPTED_PCSC_READER_NAME]
# hsm_provider_pcsc_users: [openxpki]  # Only when that existing service account uses local PCSC.

# Approved network appliance client; commissioning and client enrollment are vendor operations.
# hsm_provider: pkcs11
# hsm_provider_mode: client
# hsm_provider_packages: [REPLACE_WITH_VENDOR_CLIENT_PACKAGE]
# hsm_provider_library: /opt/REPLACE_WITH_VENDOR/lib/libpkcs11.so
# hsm_provider_config_files:
#   - src: /REPLACE_WITH_CONTROLLER_PATH/vendor-client.conf
#     dest: /etc/REPLACE_WITH_VENDOR/client.conf
#     group: openxpki
#     mode: "0640"
# hsm_provider_environment: {}  # nonsecret vendor-native configuration paths only

# Issuer-only binding after inactive runtime installation, through hsm-issuer.yml.
# Include the actual OpenSSL engine package (Debian: libengine-pkcs11-openssl) above.
# hsm_provider_user: openxpki
# hsm_provider_group: openxpki
# hsm_issuer_engine_library: /usr/lib/x86_64-linux-gnu/engines-3/pkcs11.so
# hsm_issuer_key: 'pkcs11:token=REPLACE;serial=REPLACE;id=%01;type=private'
# hsm_issuer_create_csr: false  # ceremony input HSM_ISSUER_PIN comes from the controller
# hsm_issuer_common_name: REPLACE_WITH_APPROVED_ISSUER_CN

# Optional restricted native PKCS11 remoting follows local acceptance.
# See hsm_remoting.yml.example; it is independent of the issuer-local path.
