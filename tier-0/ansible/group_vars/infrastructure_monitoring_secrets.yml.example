---
# Encrypted/ignored local inputs only. No real credentials belong in the source inventory.
infrastructure_monitoring_child_key: ""
infrastructure_monitoring_pve_image: ""
infrastructure_monitoring_pve_credentials: {}
# proxmox-a: {user: monitor@pve, token_name: monitoring, token_value: REPLACE}
# Provision a separated read-only PVEMonitor token and read-only BMC account before apply.
infrastructure_monitoring_private_files: {}
# Required: tls.crt, tls.key, ca.crt, health_alarm_notify.conf, heartbeat.curl,
# hardware-a-password; export.crt/export.key when exporting metrics.
# health_alarm_notify.conf uses native Netdata notification settings, for example:
# SEND_EMAIL="NO"
# SEND_SLACK="YES"
# SLACK_WEBHOOK_URL="https://approved-external-notifier.example.org/private-token"
# DEFAULT_RECIPIENT_SLACK="infrastructure"
# heartbeat.curl is a native curl config: url = "https://external-watchdog.example.org/private-token"
