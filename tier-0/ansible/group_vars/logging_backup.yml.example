# Pass explicitly with -e @ansible/group_vars/logging_backup.yml.
# Provision the selected independent guest through syslog's Terraform inputs,
# or select an accepted existing Linux host under logging_recovery.
logging_backup_source: ""  # NAS archive share; read-only credential distinct from transfer identity
logging_backup_marker: ""
# New path: a dedicated attached disk on the independent recovery host, outside the source NAS failure domain.
# Shared prepares a guarded filesystem and UUID mount; select the actual guest device before deployment.
logging_backup_repository: /srv/security-log-backup
logging_backup_repository_device: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
logging_backup_repository_fstype: xfs
# Empty for a new blank disk; pin the original filesystem UUID for existing/restored local storage.
logging_backup_repository_uuid: ""
logging_backup_repository_min_free_bytes: 1073741824
# Adoption alternative: set repository_device to "" and repository to its already commissioned mount root.
# That route never formats or changes its mount declaration; the role still checks identity/separation.
logging_backup_initialize: false  # approve only first initialization; restore existing repository otherwise
logging_backup_calendar: hourly
logging_backup_watchdog_url: ""  # independent dead-man check, separate from collector checkpoint check
