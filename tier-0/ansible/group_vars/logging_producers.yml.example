# Local inputs; reusable implementation: Shared ansible/roles/log_forwarder.
# Defaults and optional settings: Shared ansible/roles/log_forwarder/defaults/main.yml.
# logging_producers already includes foundation_logging; reuse other approved inventory groups/hosts.
# Set the stable service DNS name once below. Override target with an IP only if DNS is unavailable.
log_forwarder_target: "{{ log_forwarder_peer }}"
log_forwarder_peer: ""  # exact receiver certificate DNS SAN
# Set a distinct external dead-man URL per host; a shared URL can hide a failed producer.
# Add streams to ansible/inventory/host_vars/<inventory-host>.yml; preserve existing host settings.
# log_forwarder_watchdog_url: <unique-host-external-dead-man-url>
# log_forwarder_streams:
#   - {name: log-1-os, kind: security, input: journal}
#   - name: log-1-audit
#     kind: security
#     input: files
#     files: [/var/log/audit/audit.log]
# CA example: separate security stream for the actual OpenXPKI/Dogtag audit files.
