# Copy to: ansible/group_vars/syslog.yml
# Guide: docs/03-deployment/stage-2-logging/README.md
# Tier 0 owns receiver configuration and evidence. Shared owns no log inventory.
platform_host_ips:
  log-1: 10.10.10.30
  # log-2: 10.10.10.31
  # rec-1: 10.10.10.32  # enable with the independent backup VM in Terraform/inventory

# Terraform's scsi1 data disk; the shared role guards creation and persists a UUID-based mount.
syslog_ng_data_device: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
syslog_ng_data_fstype: xfs
# Leave empty for a new blank disk. Pin the original UUID for an existing/restored volume.
# With multiple receivers, put each explicit UUID/device override in its own inventory host variables.
syslog_ng_data_uuid: ""
syslog_ng_data_mount: /srv/security-logging
# IaC installs/starts firewalld when managed; use the actual intake-interface zone.
syslog_ng_firewall_zone: public
# Optional new RPM source, configured by Shared rather than by logging into the guest.
# baseline_rpm_repositories:
#   - name: approved-syslog
#     baseurl: https://mirror.internal.example.com/syslog-ng/el10/x86_64
#     gpgkey: https://mirror.internal.example.com/keys/syslog-ng.asc
#     fingerprint: REPLACE_WITH_VERIFIED_KEY_FINGERPRINT_WITHOUT_SPACES
#     repo_gpgcheck: false  # set true when this source signs RPM metadata too
# baseline_trust_anchors: [/absolute/controller/path/internal-root.pem]
# Bind client certificates to a server-owned source name, tier and observed IPv4 address.
# Certificate CN must equal name; tls_dn is the exact subject, without wildcard matching.
syslog_ng_sources: []
# Example entry after issuing a client certificate:
#  - name: pve01
#    address: 10.10.10.11
#    tier: 0
#    tls_dn: CN=pve01
# Optional, explicitly accepted unauthenticated first hop; empty means no UDP listener.
syslog_ng_legacy_sources: []
# TLS files are supplied through SYSLOG_NG_TLS_CA_FILE, SYSLOG_NG_TLS_CERT_FILE
# and SYSLOG_NG_TLS_KEY_FILE on the execution host. Never store private keys here.
