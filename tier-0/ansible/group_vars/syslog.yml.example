# Copy to: ansible/group_vars/syslog.yml
# Guide: docs/03-deployment/stage-2-logging/README.md
# Tier 0 owns receiver configuration and evidence. Shared owns no log inventory.
# Receiver defaults: ansible/roles/syslog_ng/defaults/main.yml
# Guest package access: common proxy in all.yml; receiver-specific DNF/APT sources in this file.
# Schema: Shared ansible/roles/baseline/defaults/main.yml; bootstrap.yml configures boot-1 only.
platform_host_ips:
  log-1: 10.10.10.30
  # log-2: 10.10.10.31
  # rec-1: 10.10.10.32  # enable with the independent backup VM in Terraform/inventory

# Optional Rocky sources for a restricted cache: uncomment for Rocky receivers.
# Other distributions must use their own existing repository files and approved sources.
# Retains publisher keys/signature checks; replaces mirror selection only in these sections.
# repository_proxy_dnf_sources:
#   - file: rocky.repo
#     section: baseos
#     baseurl: 'https://dl.rockylinux.org/pub/rocky/$releasever/BaseOS/$basearch/os/'
#   - file: rocky.repo
#     section: appstream
#     baseurl: 'https://dl.rockylinux.org/pub/rocky/$releasever/AppStream/$basearch/os/'
#   - file: rocky-extras.repo
#     section: extras
#     baseurl: 'https://dl.rockylinux.org/pub/rocky/$releasever/extras/$basearch/os/'

# Terraform's scsi1 data disk; the shared role guards creation and persists a UUID-based mount.
syslog_ng_data_device: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
syslog_ng_data_fstype: xfs
# Leave empty for a new blank disk; Ansible persists the verified UUID mount automatically.
# Optional identity guard after preparation: copy the printed syslog_ng_data_uuid line here for one receiver.
# Multiple receivers: remove this entry, even when empty, from this file and other -e/--ansible-vars files.
# Save each pin in ansible/inventory/host_vars/<receiver>.yml, beside inventory/hosts.yml.
# deploy.sh passes this file with -e, which overrides host vars; ansible/host_vars is not auto-loaded here.
# Recovery uses the original filesystem UUID; see the guide before adopting a restored volume.
syslog_ng_data_uuid: ""
syslog_ng_data_mount: /srv/security-logging
# IaC installs/starts firewalld when managed; use the actual intake-interface zone.
syslog_ng_firewall_zone: public
# Optional new RPM source, configured by Shared rather than by logging into the guest.
# baseline_rpm_repositories:
#   - name: approved-syslog
#     baseurl: https://mirror.internal.example.com/syslog-ng/el10/x86_64
#     gpgkey: https://mirror.internal.example.com/keys/syslog-ng.asc
#     fingerprint: REPLACE_WITH_VERIFIED_KEY_FINGERPRINT_WITHOUT_SPACES
#     repo_gpgcheck: false  # set true when this source signs RPM metadata too
# baseline_trust_anchors: [/absolute/controller/path/internal-root.pem]
# Bind client certificates to a server-owned source name, tier and observed IPv4 address.
# Certificate CN must equal name; tls_dn is the exact subject, without wildcard matching.
syslog_ng_sources: []
# Example entry after issuing a client certificate:
#  - name: pve01
#    address: 10.10.10.11
#    tier: 0
#    tls_dn: CN=pve01
# Optional, explicitly accepted unauthenticated first hop; empty means no UDP listener.
syslog_ng_legacy_sources: []
# TLS files are supplied through SYSLOG_NG_TLS_CA_FILE, SYSLOG_NG_TLS_CERT_FILE
# and SYSLOG_NG_TLS_KEY_FILE on the execution host. Never store private keys here.
