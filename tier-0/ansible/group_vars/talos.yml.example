# Talos uses its API, not SSH/Ansible guest configuration.
# These addresses feed static NoCloud networking in terraform/deployments/kubernetes/terraform.tfvars.
# Reserve them outside DHCP. Legacy bootstrap_network = null still needs matching DHCP reservations.
# Keep DNS/time/image access available without the cluster, FreeIPA, or Vault.
platform_host_ips:
  k8ctl-1: 10.10.13.10
  k8ctl-2: 10.10.13.11
  k8ctl-3: 10.10.13.12
