# Copy to: ansible/group_vars/vault.yml
# Replace every value before use.
# Reference guide: docs/03-deployment/stage-6-secrets/step-1b-vault-vm.md
# Schema/defaults: ansible/roles/vault/defaults/main.yml
# Post-unseal API fields: ansible/roles/control_applications/defaults/main.yml

platform_host_ips:
  vault-1: 10.20.21.40

vault_api_addr: "https://vault01.example.internal:8200"
vault_cluster_addr: "https://vault01.example.internal:8201"
vault_node_id: "vault01"

# These paths are read from the Ansible control machine and should stay local
# and untracked. Resolve from the tier's ansible.cfg, independent of recipe depth.
vault_tls_cert_src: "{{ ansible_config_file | dirname }}/../secrets/vault/vault01-fullchain.pem"
vault_tls_key_src: "{{ ansible_config_file | dirname }}/../secrets/vault/vault01.key"
vault_tls_ca_src: "{{ ansible_config_file | dirname }}/../secrets/vault/internal-ca.pem"

vault_listener_address: "0.0.0.0:8200"
vault_ui_enabled: true
vault_tls_min_version: "tls12"

# Leave empty for the first single-node bootstrap, then add peers later.
vault_raft_retry_join: []

# Example:
# vault_raft_retry_join:
#   - leader_api_addr: "https://vault02.example.internal:8200"
#     leader_tls_servername: "vault02.example.internal"

# Leave empty when using the default Shamir seal.
vault_seal_hcl: ""
vault_extra_hcl: ""
vault_seal_type: shamir
# Transit and licensed PKCS11 settings: Stage 6 option 1c; never embed a token/PIN in HCL.
vault_transit: {}
vault_seal_environment: {}
vault_provider_packages: []
vault_provider_accepted: false

# Run vault-configure.yml after the independent initialization/unseal ceremony.
control_applications_vault_phase: configure
control_applications_vault_token: "{{ lookup('ansible.builtin.env', 'VAULT_TOKEN') }}"
control_applications_oidc_issuer: https://sso.lab.example.com/realms/platform
control_applications_oidc_ca_pem: ""
control_applications_oidc_client_secrets: {}
control_applications_vault_policies:
  platform-read:
    'path "secret/data/platform/*" { capabilities = ["read"] }'
control_applications_vault_oidc_roles:
  - {name: platform-read, groups: [platform-readers], policies: [platform-read]}
control_applications_register_clients: false
# When registering the client here, also set hosts.keycloak, keycloak_realm and
# keycloak_auth in the private inputs. The selected VM callback includes its API port.
control_applications_backup_restore_accepted: false
control_applications_vault_audit_forwarding_accepted: false
