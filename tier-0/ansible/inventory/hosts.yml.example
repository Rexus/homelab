# Tier-owned logical hosts. IPs live in setup group vars.
all:
  vars:
    ansible_host: "{{\n  platform_host_ips.get(inventory_hostname, inventory_hostname)\n  if platform_host_ips\
      \ is defined\n  else inventory_hostname\n}}"
  children:
    hypervisors:
      hosts: {}
    foundation:
      children:
        identity: null
        issuing_ca: null
        root_ca: null
    # Dedicated FreeIPA VMs, outside Talos; Keycloak belongs to clusters/tier0/.
    identity:
      children:
        identity_primary: null
        identity_replicas: null
    identity_primary:
      hosts:
        idm-1: {}
    identity_replicas:
      hosts:
        idm-2: {}
    issuing_ca:
      hosts:
        ca-1: {}
    root_ca:
      hosts: {}
    vault:
      hosts:
        vault-1: {}
    hsm_gateways:
      hosts:
        hsm-1:
          hsm_proxy_ingress_backend_port: 8443
        hsm-2:
          hsm_proxy_ingress_backend_port: 8443
    crypto_admin:
      hosts: {}
    immutable_template_builders:
      hosts:
        rhel-10-immu-tmpl: {}
    template_refresh_builders:
      hosts:
        alma-10-tmpl-stage: {}
    # Talos inventory is consumed by Tier 0 Terraform, never by the Linux guest baseline.
    talos:
      children:
        talos_control_plane: null
        talos_workers: null
    talos_control_plane:
      hosts:
        k8ctl-1: {}
        k8ctl-2: {}
        k8ctl-3: {}
    talos_workers:
      hosts:
        k8node-1: {}
    guests:
      children:
        foundation: null
        vault: null
        hsm_gateways: null
        crypto_admin: null
        immutable_template_builders: null
        template_refresh_builders: null
