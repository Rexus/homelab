# Tier-owned logical hosts. IPs live in setup group vars.
all:
  vars:
    # DHCP guests need a resolvable environment-specific DNS name before Ansible runs.
    ansible_host: >-
      {{
        platform_fqdn | default(inventory_hostname)
        if (platform_host_ips | default({})).get(inventory_hostname) == 'dhcp'
        else (platform_host_ips | default({})).get(inventory_hostname, inventory_hostname)
      }}
  children:
    hypervisors:
      hosts: {}
    foundation_logging:
      hosts:
        log-1: {}
        # Required redundancy before accepting the HA security-logging contract.
        # log-2: {}
    foundation:
      children:
        identity: null
        issuing_ca: null
    # Dedicated FreeIPA VMs, outside Kubernetes; Keycloak belongs to clusters/tier0/.
    identity:
      children:
        identity_primary: null
        identity_replicas: null
    identity_primary:
      hosts:
        idm-1: {}
    identity_replicas:
      hosts:
        idm-2: {}
    issuing_ca:
      hosts:
        ca-1: {}
    root_ca:
      hosts: {}
    vault:
      hosts:
        vault-1: {}
    hsm_gateways:
      hosts:
        hsm-1:
          hsm_proxy_ingress_backend_port: 8443
        hsm-2:
          hsm_proxy_ingress_backend_port: 8443
        # Add replicas with matching Terraform and platform_host_ips entries.
        # hsm-3:
        #   hsm_proxy_ingress_backend_port: 8443
    crypto_admin:
      hosts: {}
    infrastructure_runner:
      hosts:
        iac-1: {}
    immutable_template_builders:
      hosts:
        rhel-10-immu-tmpl: {}
    template_refresh_builders:
      hosts:
        alma-10-tmpl-stage: {}
    # Current Kubernetes implementation: Talos; preserve these OS-specific groups on upgrades.
    # Tier 0 Terraform consumes them, never the Linux guest baseline.
    talos:
      children:
        talos_control_plane: null
        talos_workers: null
    talos_control_plane:
      hosts:
        k8ctl-1: {}
        k8ctl-2: {}
        k8ctl-3: {}
    talos_workers:
      hosts: {}
    guests:
      children:
        foundation_logging: null
        foundation: null
        vault: null
        hsm_gateways: null
        crypto_admin: null
        infrastructure_runner: null
        immutable_template_builders: null
        template_refresh_builders: null
