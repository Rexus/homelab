# Edit host names and group membership here; keep guest entries as host-name: {}.
# Guest IPs: ansible/group_vars/<setup>.yml under platform_host_ips.
# Common login/domains: ansible/group_vars/all.yml.
# Keep inherited ansible_host formulas. Use a per-host override only for an explicit exception.
# Guide: docs/08-reference/platform-inputs.md#inventory-and-connection-addresses
all:
  vars:
    # DHCP guests need a resolvable environment-specific DNS name before Ansible runs.
    ansible_host: >-
      {{
        platform_fqdn | default(inventory_hostname)
        if (platform_host_ips | default({})).get(inventory_hostname) == 'dhcp'
        else (platform_host_ips | default({})).get(inventory_hostname, inventory_hostname)
      }}
  children:
    hypervisors:
      vars:
        ansible_host: "{{ inventory_hostname }}.{{ platform_internal_domain | default(platform_domain) }}"
      # Replace pve01 with existing Proxmox node names; internal DNS must resolve them.
      hosts:
        pve01: {}
    # Stage 6 managed monitor or accepted existing host; outside observed Kubernetes clusters.
    infrastructure_monitoring:
      hosts: {}
      # Managed path: replace hosts: {} above with these uncommented lines.
      # hosts:
      #   mon-1: {}
    control_recovery:
      hosts: {}
    foundation_logging:
      hosts:
        log-1: {}
        # Required redundancy before accepting the HA security-logging contract.
        # log-2: {}
    # Reuse receiver hosts and connection settings for their own OS forwarding.
    # Enroll other approved Linux groups/hosts here; keep their existing definitions.
    logging_producers:
      children:
        foundation_logging: null
    logging_recovery:
      hosts: {}
      # hosts:
      #   rec-1: {}
    foundation:
      children:
        identity: null
        issuing_ca: null
    # Dedicated FreeIPA VMs, outside Kubernetes; Keycloak belongs to clusters/tier0/.
    identity:
      # Authorities need their directory FQDN while commissioning the realm.
      vars:
        platform_domain_role: authority
      children:
        identity_primary: null
        identity_replicas: null
    identity_primary:
      hosts:
        idm-1: {}
    identity_replicas:
      hosts:
        idm-2: {}
    issuing_ca:
      hosts:
        ca-1: {}
    root_ca:
      hosts: {}
    vault:
      hosts:
        vault-1: {}
    hsm_gateways:
      hosts:
        hsm-1:
          hsm_proxy_ingress_backend_port: 8443
        hsm-2:
          hsm_proxy_ingress_backend_port: 8443
        # Add replicas with matching Terraform and platform_host_ips entries.
        # hsm-3:
        #   hsm_proxy_ingress_backend_port: 8443
    crypto_admin:
      hosts: {}
      # Optional ceremony administration guest from the hsm setup.
      # hosts:
      #   cadm-1: {}
    infrastructure_runner:
      hosts:
        iac-1: {}
    # Independently provisioned private API gateways; never public edge or cluster workloads.
    cluster_endpoint:
      hosts:
        api-gw-1: {}
        api-gw-2: {}
    immutable_template_builders:
      hosts:
        rhel-10-immu-tmpl: {}
    template_refresh_builders:
      hosts:
        alma-10-tmpl-stage: {}
    # Current Kubernetes implementation: Talos; preserve these OS-specific groups on upgrades.
    # Tier 0 Terraform consumes them, never the Linux guest baseline.
    talos:
      children:
        talos_control_plane: null
        talos_workers: null
    talos_control_plane:
      hosts:
        k8ctl-1: {}
        k8ctl-2: {}
        k8ctl-3: {}
    talos_workers:
      hosts: {}
    guests:
      children:
        foundation_logging: null
        logging_recovery: null
        foundation: null
        vault: null
        hsm_gateways: null
        crypto_admin: null
        infrastructure_runner: null
        cluster_endpoint: null
        immutable_template_builders: null
        template_refresh_builders: null
