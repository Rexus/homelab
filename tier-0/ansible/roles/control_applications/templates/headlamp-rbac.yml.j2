{% for namespace in control_applications_headlamp_namespaces %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: headlamp-viewers
  namespace: {{ namespace | to_json }}
subjects:
  - kind: Group
    name: {{ control_applications_headlamp_group | to_json }}
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: ClusterRole
  name: view
  apiGroup: rbac.authorization.k8s.io
{% endfor %}
