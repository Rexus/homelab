apiVersion: v1
kind: Service
metadata: {name: netbox-cache, namespace: netbox}
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: netbox-cache}
  ports: [{name: tls, port: 6379, targetPort: 6379}]
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: netbox-cache, namespace: netbox}
spec:
  serviceName: netbox-cache
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: netbox-cache}
  template:
    metadata:
      labels: {app.kubernetes.io/name: netbox-cache}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: valkey
          image: {{ control_applications_valkey_image | to_json }}
          command: [valkey-server, /etc/valkey/valkey.conf]
          ports: [{name: tls, containerPort: 6379}]
          env:
            - name: VALKEYCLI_AUTH
              valueFrom: {secretKeyRef: {name: netbox-cache, key: password}}
          readinessProbe:
            exec:
              command: [valkey-cli, --tls, --cacert, /tls/ca.crt, -h, netbox-cache, ping]
            initialDelaySeconds: 5
          livenessProbe:
            tcpSocket: {port: tls}
            initialDelaySeconds: 30
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {memory: 512Mi}
          volumeMounts:
            - {name: config, mountPath: /etc/valkey, readOnly: true}
            - {name: tls, mountPath: /tls, readOnly: true}
            - {name: data, mountPath: /data}
      volumes:
        - name: config
          secret:
            secretName: netbox-cache
            items: [{key: valkey.conf, path: valkey.conf}]
        - {name: tls, secret: {secretName: netbox-cache-tls}}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: {{ control_applications_storage_class | to_json }}
        resources:
          requests: {storage: 2Gi}
