apiVersion: v1
kind: Config
current-context: human-oidc
clusters:
  - name: selected-cluster
    cluster:
      server: {{ sso_human_api_server | to_json }}
      certificate-authority-data: {{ sso_human_api_ca_pem | b64encode | to_json }}
contexts:
  - name: human-oidc
    context:
      cluster: selected-cluster
      user: human-oidc
      namespace: {{ sso_human_namespaces[0] | to_json }}
users:
  - name: human-oidc
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        interactiveMode: IfAvailable
        command: {{ sso_human_kubelogin | to_json }}
        args:
          - get-token
          - {{ ('--oidc-issuer-url=' ~ sso_human_keycloak_url ~ '/realms/' ~ sso_human_realm) | to_json }}
          - {{ ('--oidc-client-id=' ~ sso_human_client_id) | to_json }}
          - --grant-type=authcode
          - --oidc-pkce-method=S256
          - --listen-address=127.0.0.1:8000
          - --oidc-redirect-url=http://localhost:8000
          - {{ ('--certificate-authority-data=' ~ (sso_human_oidc_ca_pem | b64encode)) | to_json }}
          - {{ ('--token-cache-dir=' ~ sso_human_output ~ '/tokens') | to_json }}
