{% for namespace in sso_human_namespaces %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: oidc-cli-viewers
  namespace: {{ namespace | to_json }}
subjects:
  - kind: Group
    name: {{ sso_human_group | to_json }}
    apiGroup: rbac.authorization.k8s.io
roleRef: {kind: ClusterRole, name: view, apiGroup: rbac.authorization.k8s.io}
{% endfor %}
