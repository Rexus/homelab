[Unit]
Description=Independent infrastructure detector heartbeat
After=netdata.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStartPre=/usr/sbin/netdatacli ping
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 15 --config /etc/netdata/private/heartbeat.curl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
