label: Logging {{ logging_pki_profile_kind }}
key:
    generate: client
validity:
    notafter: '+000030'
digest: sha384
style:
    approved_csr:
        label: Approved logging identity
        ui:
            subject: [logging_name]
{% if logging_pki_profile_kind == 'server' %}
            san: [logging_dns]
{% endif %}
        subject:
            dn: CN=[% logging_name %]
template:
    logging_name:
        id: logging_name
        label: Logging identity
        type: text
        preset: CN
        required: 1
        match: \A [a-z][a-z0-9_-]{0,62} \z
{% if logging_pki_profile_kind == 'server' %}
    logging_dns:
        id: dns
        label: Approved logging DNS name
        type: text
        required: 1
        min: 1
        max: 20
        match: \A (?i:(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)*(?:{{ openxpki_bundle_dns_suffixes | map('regex_escape') | join('|') }})) \z
{% endif %}
extensions:
    basic_constraints:
        critical: 1
        ca: 0
    key_usage:
        critical: 1
        digital_signature: 1
    extended_key_usage:
        critical: 0
        {{ 'client_auth' if logging_pki_profile_kind == 'client' else 'server_auth' }}: 1
