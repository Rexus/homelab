ui = {{ vault_ui_enabled | ternary("true", "false") }}
api_addr = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"
{% if vault_product | default('vault') == 'vault' %}
disable_mlock = {{ vault_disable_mlock | ternary("true", "false") }}
{% endif %}
{% if vault_product | default('vault') == 'openbao' %}
audit "file" "file" {
  options {
    file_path = {{ (vault_log_dir ~ '/audit.log') | to_json }}
    mode = "0600"
  }
}
audit "file" "stdout" {
  options {
    file_path = "stdout"
  }
}
{% endif %}
{% if vault_product | default('vault') == 'openbao' and openbao_pkcs11_enabled | default(false) %}
plugin_directory = {{ openbao_plugin_directory | to_json }}
plugin_auto_download = false
plugin "kms" "pkcs11" {
  command = "openbao-plugin-kms-pkcs11"
  version = {{ ('v' ~ openbao_plugin_version) | to_json }}
  sha256sum = {{ openbao_plugin_sha256 | to_json }}
  args = [{{ ('-alias=hsm=' ~ openbao_pkcs11_library) | to_json }}]
}
{% endif %}

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ vault_node_id }}"
{% for peer in vault_raft_retry_join %}
  retry_join {
    leader_api_addr = "{{ peer.leader_api_addr }}"
{% if peer.leader_tls_servername is defined and peer.leader_tls_servername %}
    leader_tls_servername = "{{ peer.leader_tls_servername }}"
{% endif %}
    leader_ca_cert_file = "{{ vault_tls_ca_dest }}"
    leader_client_cert_file = "{{ vault_tls_cert_dest }}"
    leader_client_key_file = "{{ vault_tls_key_dest }}"
  }
{% endfor %}
}

listener "tcp" {
  address            = "{{ vault_listener_address }}"
  tls_cert_file      = "{{ vault_tls_cert_dest }}"
  tls_key_file       = "{{ vault_tls_key_dest }}"
  tls_client_ca_file = "{{ vault_tls_ca_dest }}"
  tls_min_version    = "{{ vault_tls_min_version }}"
}

{% if vault_seal_type == 'transit' %}
seal "transit" {
  address = {{ vault_transit.address | to_json }}
  key_name = {{ vault_transit.key_name | to_json }}
  mount_path = {{ vault_transit.get('mount_path', 'transit/') | to_json }}
  tls_ca_cert = "/etc/vault-seal/transit-ca.pem"
  tls_server_name = {{ vault_transit.tls_server_name | to_json }}
}
{% elif vault_seal_hcl | trim %}
{{ vault_seal_hcl | trim }}
{% endif %}
{% if vault_extra_hcl | trim %}
{{ vault_extra_hcl | trim }}
{% endif %}
