# Tier 0-owned starter. Copy to .gitlab-ci.yml after configuring the protected runner.
# Optional Day 2 scheduling; initial Day 0-1 publication uses the local template commands.
# Reference: docs/platforms/proxmox/template-lifecycle.md#gitlab-ci-example
stages: [plan, publish]

default:
  tags: [tier0-templates]
  before_script:
    - test -n "$TEMPLATE_STATE_PATH"
    - test -n "$TEMPLATE_CATALOG_FILE"

workflow:
  rules:
    - if: '$CI_COMMIT_REF_PROTECTED == "true" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - when: never

template-plan:
  stage: plan
  resource_group: tier0-proxmox-templates
  script:
    - bash scripts/proxmox-templates.sh plan
  artifacts:
    access: maintainer
    expire_in: 1 day
    paths:
      - .terraform/plans/proxmox-templates.tfplan
      - terraform/templates/.terraform.lock.hcl

template-publish:
  stage: publish
  needs: [template-plan]
  resource_group: tier0-proxmox-templates
  when: manual
  allow_failure: false
  environment:
    name: tier0-templates
  script:
    - bash scripts/proxmox-templates.sh apply
