# Tier 0-owned starter. Copy to .gitlab-ci.yml after configuring the protected runner.
# Optional hosted scheduling after protected-runner handover; initial publication runs locally.
# The template command prepares its isolated Ansible runtime; stage offline artifacts when disconnected.
# Preinstall OS packages in unprivileged images, or provide noninteractive sudo for missing packages.
# Successful apply updates the writable sibling Shared catalog. For a different existing
# checkout, export TEMPLATE_SHARED_CATALOG_FILE. Review and commit that repository separately.
# Reference: docs/administration/virtual-machines/template-lifecycle.md#gitlab-ci-example
stages: [plan, publish]

default:
  tags: [tier0-templates]
  before_script:
    - test -n "$TEMPLATE_STATE_PATH"
    - test -n "$TEMPLATE_CATALOG_FILE"

workflow:
  rules:
    - if: '$CI_COMMIT_REF_PROTECTED == "true" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - when: never

template-plan:
  stage: plan
  resource_group: tier0-proxmox-templates
  script:
    - bash scripts/proxmox-templates.sh plan
  artifacts:
    access: maintainer
    expire_in: 1 day
    paths:
      - .terraform/plans/proxmox-templates.tfplan
      - terraform/deployments/templates/.terraform.lock.hcl

template-publish:
  stage: publish
  needs: [template-plan]
  resource_group: tier0-proxmox-templates
  when: manual
  allow_failure: false
  environment:
    name: tier0-templates
  script:
    - bash scripts/proxmox-templates.sh apply
