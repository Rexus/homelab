# Copy to: .env.local
# Replace every value before use.

# Terraform bpg/proxmox endpoint. Do not append /api2/json.
PROXMOX_API_URL=https://proxmox.example.com:8006/
PROXMOX_API_TOKEN_ID=automation@pve!provision
PROXMOX_API_TOKEN_SECRET=change-me

# Public key files must exist on the execution host, outside this repository.
# Set an absolute path in .env.local; no key contents belong in Git.
# TF_VAR_ssh_public_key_files='["/home/operator/.ssh/id_ed25519.pub"]'
# Ansible uses the matching private key through ssh-agent or local SSH config.

# Optional FreeIPA bootstrap secrets; prefer protected runner/shell injection.
# FREEIPA_DM_PASSWORD=change-me
# FREEIPA_ADMIN_PASSWORD=change-me

# Optional for encrypted Ansible-only secret files. Use an absolute controller path.
# ANSIBLE_VAULT_PASSWORD_FILE=/home/operator/.config/homelab/ansible-vault-password.txt
