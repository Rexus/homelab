# Build fields/defaults: terraform/modules/proxmox_templates/variables.tf (images entries)
# Catalog aliases and resolution: terraform/deployments/templates/main.tf
# Root input variables: terraform/deployments/templates/variables.tf
# Family/distribution choices and Windows example: docs/08-reference/template-publication.md#os-families-and-windows

# Copy to templates/proxmox.yml using Tier 0's scripts/proxmox-templates.sh init command.
# Compute foundation: publish templates locally before creating managed VMs or the control cluster.
# Reference: docs/05-operations/01-hosting/templates/template-lifecycle.md
# VMID allocation: docs/02-conventions/vmid-convention.md (templates use 9xxx).
# Set site-specific values. Keep only the images being managed by this state.
# Each build overrides individual all fields; lists (including tags) are replaced, not merged.
# Release track (for example el10), distribution, CPU profile and CloudInit tags are automatic.
# Build tags are extras that clones may inherit; avoid template-only status or tier ownership.
# release: exact version/build (optional v prefix), not a filename, placeholder or latest/stable alias.
# Connected Tier 0 uses a protected control network; offline custody needs a separate isolated fabric.
# Add a new entry and VMID for every revision; retain previous entries for rollback.
all:
  node_name: pve01
  # Shared config/platform.tfvars: proxmox_storage_classes.shared.vm_disk.
  # Explicit datastore_id here or in one build overrides storage_class.
  storage_class: shared
  # Tier 0-local image staging with Import content; not the live VM disk class.
  image_datastore_id: local
  # SDN alternative: use the existing VNet ID as bridge and set vlan_id: null.
  # The VNet owns VLAN tagging; zones/VNets are prepared separately.
  # Reference: docs/03-deployment/foundation/proxmox/step-1c-sdn.md
  bridge: vmbr0
  # Select the prepared bootstrap/control VLAN once here; use null for untagged.
  vlan_id: 10
  # MTU 1500, NIC firewall and QEMU agent enabled; SCSI controller follows OS family.
  # Add nic_mtu, nic_firewall, qemu_agent or scsi_hardware only to override defaults.
  bios: ovmf
  machine: q35
  cores: 2
  memory_mb: 2048
  # Template baseline; use at least the source image's virtual size. Size service clones separately.
  disk_size_gb: 10
  # Initialization drive at ide2 with IPv4 DHCP (NoCloud for Linux, ConfigDrive2 for Windows).
  # Disable per build when the image has no initialization agent; accounts belong to clones.
  cloud_init_drive: true

templates:
  debian-build-1:
    family: debian
    distribution: debian
    release: REPLACE_WITH_EXACT_DEBIAN_12_BUILD
    vm_id: 9103
    name: debian-template-build-1
    image_path: /srv/tier0/artifacts/debian-12-genericcloud-amd64.qcow2
    sha256: REPLACE_WITH_UNPACKED_IMAGE_SHA256
    tags: [] # Optional image variants, for example [test] or [hardened].
  alma-build-1:
    family: redhat
    distribution: alma
    release: REPLACE_WITH_EXACT_RELEASE_AND_BUILD
    vm_id: 9100
    name: alma-template-build-1
    image_path: /srv/tier0/artifacts/alma-build-1.qcow2
    sha256: REPLACE_WITH_UNPACKED_IMAGE_SHA256
    tags: [] # Optional image variants, for example [test] or [hardened].
  rocky-build-1:
    family: redhat
    distribution: rocky
    release: REPLACE_WITH_EXACT_RELEASE_AND_BUILD
    vm_id: 9101
    name: rocky-template-build-1
    image_path: /srv/tier0/artifacts/rocky-build-1.qcow2
    sha256: REPLACE_WITH_UNPACKED_IMAGE_SHA256
    tags: [] # Optional image variants, for example [test] or [hardened].
  talos-build-1:
    # Complete reference path with human SSO: select an approved exact Talos 1.13.x release.
    # Match installer/schematic and talosctl; 1.14 is not qualified by the supplied SSO rollout.
    family: talos
    distribution: talos
    release: REPLACE_WITH_EXACT_TALOS_VERSION
    schematic_id: REPLACE_WITH_IMAGE_FACTORY_SCHEMATIC_ID
    vm_id: 9102
    name: talos-template-build-1
    image_path: /srv/tier0/artifacts/nocloud-amd64.raw
    sha256: REPLACE_WITH_UNPACKED_IMAGE_SHA256
    tags: [] # Optional image variants, for example [test] or [hardened].
    # When adopting a GUI upload, preserve its exact basename instead of renaming it:
    # image_file_name: nocloud-amd64.raw
    # Image Factory: Cloud server / NoCloud / amd64 / UEFI only (not Secure Boot).
    # Include siderolabs/qemu-guest-agent. Upload the unpacked .raw, not .raw.xz.
    # Firmware must match new consuming clusters; never change a live cluster implicitly.
