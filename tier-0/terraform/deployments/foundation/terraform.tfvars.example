# Variable definitions (this repository): terraform/deployments/foundation/variables.tf

# Copy to: terraform/deployments/foundation/terraform.tfvars
# Optionally copy to terraform.<env>.tfvars only for environment overrides.
# Replace every value before use.
# Shared root: Stage 2 issuer, Stage 5 directory and optional Stage 6 monitor use the same state.
# Issuer: docs/03-deployment/stage-02-trust/procedures/issuer.md
# Directory: docs/03-deployment/stage-05-identity/procedures/freeipa.md
# Monitor: docs/03-deployment/stage-06-secrets/procedures/independent-monitoring.md
# VMID allocation: docs/02-conventions/vmid-convention.md
# Tier network inputs live in ../../common.tfvars; the shared helper loads platform/image references.

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# Source-image tags are read by template ID from the shared proxmox_template_catalog. Use template_catalog_id only when a builder VM should use
# tags for a target template ID instead of the source clone template ID.
# default_linux_vm_template_id = 9100

# Fresh VMs select TPM 2.0 below; omit tpm or set tpm = null to opt out (legacy default).
# Requires tpm_state_present = false in the applied/inspected Shared clone-source reference.
# Existing VM TPM/boot hardware is preserved; this does not enable Secure Boot or encryption.
vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  # Stage 2 starts with the issuer only.
  "ca-1" = {
    # OpenXPKI native packages require the separately approved Debian image.
    template_vm_id    = 9103
    # Option 1d only: pin the issuer to the physical USB device's node and mapping.
    # proxmox_node_name = "pve01"
    # usb_devices      = [{ mapping = "ca-1-token" }]
    vm_id             = 311
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 30
    tpm               = {}
    extra_disks       = [{ interface = "scsi1", size_gb = 40, storage_class = "local" }]
    network_zone_key  = "cryptography"
    tags              = ["issuing-ca", "critical", "restricted", "always-on", "security"]
  }
  # Stage 5: uncomment both directory guests when selecting a new FreeIPA pair.
  # Retain ca-1 and every other guest already managed by this state.
  # Dedicated directory VMs remain separate from the Kubernetes identity provider.
  # "idm-1" = {
  #   # Optional per-guest override: template_vm_id = an approved EL template ID.
  #   vm_id             = 301
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 40
  #   tpm               = {}
  #   network_zone_key  = "identity"
  #   tags              = ["freeipa", "dns", "critical", "internal", "always-on", "platform"]
  # }
  # "idm-2" = {
  #   vm_id             = 302
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 40
  #   tpm               = {}
  #   network_zone_key  = "identity"
  #   tags              = ["freeipa", "dns", "critical", "internal", "always-on", "platform"]
  # }
  # Stage 6 only: enable with the matching inventory host and foundation IP entry.
  # Keep all existing issuer/directory entries and this root's original state.
  # "mon-1" = {
  #   vm_id            = 511
  #   size             = "medium"
  #   storage_class    = "local"
  #   disk_size_gb     = 40
  #   tpm              = {}
  #   network_zone_key = "management"
  #   tags             = ["monitoring", "critical", "internal", "always-on"]
  # }
  # Offline root custody is deliberately outside this connected deployment/state.
}

lxc_instances = {}
