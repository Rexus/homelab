# Copy to: terraform/deployments/foundation/terraform.tfvars
# Optionally copy to terraform.<env>.tfvars only for environment overrides.
# Replace every value before use.
# Setup guide: docs/deployment/stage-3-identity/procedures/freeipa.md
# Tier network inputs live in ../../common.tfvars; the shared helper loads platform/image references.

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# Source-image tags are read by template ID from the shared proxmox_template_catalog. Use template_catalog_id only when a builder VM should use
# tags for a target template ID instead of the source clone template ID.
# default_linux_vm_template_id = 9100

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  # Dedicated FreeIPA pair, separate from the Kubernetes cluster hosting Keycloak.
  "idm-1" = {
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 9100
    vm_id             = 200
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "identity"
    tags              = ["freeipa", "dns", "critical", "internal", "always-on", "platform"]
  }
  "idm-2" = {
    vm_id             = 201
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "identity"
    tags              = ["freeipa", "dns", "critical", "internal", "always-on", "platform"]
  }
  "ca-1" = {
    # OpenXPKI native packages require the separately approved Debian image.
    template_vm_id    = 9103
    vm_id             = 210
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 30
    extra_disks       = [{ interface = "scsi1", size_gb = 40, storage_class = "local" }]
    network_zone_key  = "cryptography"
    tags              = ["issuing-ca", "critical", "restricted", "always-on", "security"]
  }
  # Offline root custody is deliberately outside this connected deployment/state.
}

lxc_instances = {}
