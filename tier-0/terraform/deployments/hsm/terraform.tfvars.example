# Variable definitions (this repository): terraform/deployments/hsm/variables.tf

# Copy to: terraform/deployments/hsm/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/03-deployment/stage-02-trust/step-1b-usb-hsm.md
# VMID allocation: docs/02-conventions/vmid-convention.md
# Shared values live in ../../common.tfvars.

hsm_variant = "hardware"

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 9101

# Keys match the stable logical host names in the Ansible inventory.
# The environment prefix or suffix from Ansible becomes the Proxmox VM name.
# Two enabled hosts are a starter, not a limit; size the pool for traffic and failure headroom.
# Each private Tier 0 service VM has one host-local HSM.
# Any VIP/proxy runs on these same VMs; no public edge or extra LB pair is required.
# Native USB attachments are declared below; middleware is selected in hsm.yml.
# The application endpoint, key ceremonies and application HA remain separate integrations.
# Separate physical hosts are examples; verify USB affinity and Proxmox HA placement.
# The Tier 0 Ansible inventory and hsm.yml include the matching hsm-1 and
# hsm-2 entries.
# Fresh VMs select TPM 2.0 below; omit tpm or set tpm = null to opt out (legacy default).
# Requires tpm_state_present = false in the applied/inspected Shared clone-source reference.
# Existing VM TPM/boot hardware is preserved; this does not enable Secure Boot or encryption.
vm_instances = {
  "hsm-1" = {
    proxmox_node_name = "pve01"
    usb_devices      = [{ mapping = "hsm-1-token" }]
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 9101
    vm_id            = 331
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    tpm              = {}
    network_zone_key = "cryptography"
    tags             = ["hsm", "pkcs11", "critical", "restricted", "always-on", "security"]
  }
  "hsm-2" = {
    proxmox_node_name = "pve02"
    usb_devices      = [{ mapping = "hsm-2-token" }]
    vm_id             = 332
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 30
    tpm               = {}
    network_zone_key  = "cryptography"
    tags              = ["hsm", "pkcs11", "critical", "restricted", "always-on", "security"]
  }
  # Add replicas with matching hsm_gateways inventory and hsm.yml IP-map entries.
  # "hsm-3" = {
  #   proxmox_node_name = "pve03"
  #   vm_id             = 333
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 30
  #   tpm               = {}
  #   network_zone_key  = "cryptography"
  #   tags              = ["hsm", "pkcs11", "critical", "restricted", "always-on", "security"]
  # }
  # New on-demand cadm-1 belongs to the separate ceremony setup.
  # Existing connected cadm-1 keeps its original configuration/state in hsm until
  # explicitly retired or migrated. Never declare one guest under both owners.
}

lxc_instances = {}

# Existing approved Proxmox resource mappings, each restricted to the intended host/device.
# A mapping does not synchronize keys or make a USB token available on another node.
# Alternatively use host = "1-2.3" for an approved physical bus-port on the pinned node.
# Raw host passthrough may require stronger Proxmox privileges than mapped devices.
