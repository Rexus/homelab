# Variable definitions (this repository): terraform/deployments/infrastructure-runner/variables.tf

# Tier 0 direct trusted-CI option. Guide: docs/03-deployment/stage-9-development/procedures/infrastructure-runner.md
# VMID allocation: docs/02-conventions/vmid-convention.md
vm_instances = {
  "iac-1" = {
    vm_id            = 511
    size             = "medium"
    storage_class    = "local"
    disk_size_gb     = 80
    network_zone_key = "management"
    tags             = ["tier-0", "infrastructure-runner", "critical", "restricted"]
  }
}
lxc_instances = {}
