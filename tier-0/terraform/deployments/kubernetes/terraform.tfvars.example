# Variable definitions (this repository): terraform/deployments/kubernetes/variables.tf
# Service DNS: docs/02-conventions/service-dns.md

# Cluster-owned hardware/configuration. This root does not load Linux common.tfvars.
# VMID allocation: docs/02-conventions/vmid-convention.md
# IP reservations are in ansible/group_vars/talos.yml, hosts in ansible/inventory/hosts.yml.
# New permanent nodes select signed ISO boot below. Existing template-based inputs remain valid.
# Pin the same approved release and schematic in the ISO and signed NoCloud installer.
# Complete reference path: approved exact Talos 1.13.x image, installer and talosctl.
# The supplied Stage 5 SSO rollout does not qualify Talos 1.14; generic version validation is not that proof.
# Configure native proxy/DNS/time or approved mirrors before denying direct egress.
# Reference: docs/03-deployment/stage-04-kubernetes/procedures/talos-terraform.md#controlled-image-access
# Linux common.tfvars and Ansible proxy settings do not apply to these nodes.
machine_config_patches = []

# NoCloud drive carries networking only; IPs come from tier-local platform_host_ips.
# Leave user/password/SSH/custom user-data unset. DNS inherits the host default;
# add dns_servers only if a qualified independent bootstrap DNS override is needed.
# Null retains the earlier DHCP-reservation path for existing clusters.
# SDN alternative: use sdn_vnet instead of prefix_length/gateway; match all node bridges and omit NIC tags.
# Reference: docs/08-reference/network-inputs.md#sdn-subnet-lookup
bootstrap_network = { prefix_length = 24, gateway = "10.10.13.1" }

# Stage 4 option 5a: prepare media/hash/storage before provisioning; see the guide below.
# docs/03-deployment/stage-04-kubernetes/procedures/secure-boot.md
# Retained template option 5b: secure_boot=null and template_vm_id=<approved Talos template ID>.
# Root defaults preserve existing inputs; never copy this selection over a running cluster.
template_vm_id = null
secure_boot = {
  iso_path               = "/srv/tier0/artifacts/nocloud-amd64-secureboot.iso"
  iso_sha256             = "REPLACE_WITH_ACCEPTED_64_HEX_SHA256"
  iso_datastore_id       = "local"
  encrypt_system_disks   = true
  install_media_attached = true
}
# Fresh signed media enrolls its trust into the per-node EFI setup-mode disk.
vm_firmware = { bios = "ovmf", machine = "q35", scsi_hardware = "virtio-scsi-pci" }
qemu_agent  = true # Requires siderolabs/qemu-guest-agent in the image and installer schematic.
cluster = {
  name               = "control"
  endpoint           = "https://api.control.example.com:6443"
  bootstrap_node     = "k8ctl-1"
  talos_version      = "REPLACE_WITH_EXACT_VERSION_WITH_v"
  kubernetes_version = "REPLACE_WITH_COMPATIBLE_VERSION_WITHOUT_v"
  installer_image    = "factory.talos.dev/nocloud-installer-secureboot/REPLACE_WITH_SCHEMATIC_ID:REPLACE_WITH_EXACT_VERSION_WITH_v"
  pod_cidr           = "10.244.0.0/16"
  service_cidr       = "10.96.0.0/12"
  allow_scheduling_on_control_planes = true
}

# Reserve each inventory IP outside DHCP and set its static NoCloud network. The endpoint needs an external
# TCP load balancer for these control planes; it cannot use in-cluster ingress.
# Keep host placement, storage, bridges, and image source in the same Proxmox cluster.
nodes = {
  k8ctl-1 = {
    vm_id = 101, node_name = "pve01", mac_address = "02:00:00:00:03:00"
    datastore_id = "shared", bridge = "control", size = "medium"
  }
  k8ctl-2 = {
    vm_id = 102, node_name = "pve02", mac_address = "02:00:00:00:03:01"
    datastore_id = "shared", bridge = "control", size = "medium"
  }
  k8ctl-3 = {
    vm_id = 103, node_name = "pve03", mac_address = "02:00:00:00:03:02"
    datastore_id = "shared", bridge = "control", size = "medium"
  }
}

# Start with three schedulable control planes. Optional workers need matching
# inventory hosts, DHCP/IP reservations, and hardware entries in nodes above.
# Reserve optional worker VMIDs in 200-299; control planes use 100-199.
# Existing clusters must retain their workers; this example is not a removal plan.
