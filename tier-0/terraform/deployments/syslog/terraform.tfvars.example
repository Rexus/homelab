# Variable definitions (this repository): terraform/deployments/syslog/variables.tf

# Copy to: terraform/deployments/syslog/terraform.tfvars
# Guide: docs/03-deployment/stage-2-logging/README.md
# VMID allocation: docs/02-conventions/vmid-convention.md
# Tier 0 owns protected log intake; shared supplies only sizes and platform/image references.
# Terraform owns VMs/disks; Tier 0 Ansible prepares guarded storage and installs the receiver with supplied TLS.
# Neither installs archive replication or protected retention.

vm_instances = {
  "log-1" = {
    vm_id            = 401
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "management"
    tags             = ["syslog", "audit", "restricted", "always-on", "control"]
    extra_disks = [{
      interface     = "scsi1"
      size_gb       = 100
      storage_class = "local"
    }]
  }
  # Bootstrap starts with one host. Enable this on a different physical host,
  # with matching inventory/IP entries, before accepting security-logging HA.
  # "log-2" = {
  #   vm_id             = 402
  #   proxmox_node_name = "pve02"
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 40
  #   network_zone_key  = "management"
  #   tags              = ["syslog", "audit", "restricted", "always-on", "control"]
  #   extra_disks = [{ interface = "scsi1", size_gb = 100, storage_class = "local" }]
  # }
  # Stage 2 NAS-retention option: enable the independent backup guest here before
  # running deployment/logging-backup.yml. Add rec-1 to logging_recovery and syslog.yml's IP map.
  # Select a different physical host and recovery storage failure domain from the collector/NAS.
  # "rec-1" = {
  #   vm_id             = 403
  #   proxmox_node_name = "pve02"
  #   size              = "small"
  #   storage_class     = "local"
  #   disk_size_gb      = 30
  #   network_zone_key  = "management"
  #   tags              = ["backup", "audit", "restricted", "control"]
  #   extra_disks = [{ interface = "scsi1", size_gb = 200, storage_class = "local" }]
  # }
}

lxc_instances = {}
