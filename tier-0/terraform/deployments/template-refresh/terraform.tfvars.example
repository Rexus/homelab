# Variable definitions (this repository): terraform/deployments/template-refresh/variables.tf

# Copy to: terraform/deployments/template-refresh/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/03-deployment/foundation/proxmox/templates.md
# VMID allocation: docs/02-conventions/vmid-convention.md
# Shared values live in ../../common.tfvars.

vm_instances = {
  # Default refresh target: one staged replacement for the normal Enterprise
  # Linux template. Expand this map when you maintain more than one template.
  #
  # vm_id is the temporary staged template ID. Keep it in the template range
  # and make it different from the final template ID until replacement runs.
  "alma-10-tmpl-stage" = {
    vm_id               = 9190
    template_catalog_id = 9100
    size                = "small"
    storage_class       = "local"
    disk_size_gb        = 20
    network_zone_key    = "application"
    started             = true
    template            = false
    stop_on_destroy     = true
  }
}

lxc_instances = {}
