# Copy to: terraform/environments/hsm/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/security/usb-hsm-active-active-blueprint.md
# Shared values live in ../../common.tfvars.

hsm_variant = "hardware"

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

# Keep the shared external edge load balancer in the edge setup by default.
# Keys match the stable logical host names in the Ansible inventory.
# The environment prefix or suffix from Ansible becomes the Proxmox VM name.
# The repository reference shape is the shared edge load-balancer set from edge
# plus two gateway hosts here, each with its own local USB HSM.
# The shared Ansible inventory and hsm.yml include the matching hsm-1 and
# hsm-2 entries.
vm_instances = {
  "hsm-1" = {
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 111
    vm_id            = 250
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "cryptography"
    tags             = ["hsm", "pkcs11", "critical", "restricted", "always-on", "security"]
  }
  "hsm-2" = {
    vm_id            = 251
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 30
    network_zone_key = "cryptography"
    tags             = ["hsm", "pkcs11", "critical", "restricted", "always-on", "security"]
  }
  # Optional cryptography administration helper, default 0. Uncomment together
  # with the matching Ansible inventory host and hsm.yml platform_host_ips
  # entry.
  # "crypto-admin-1" = {
  #   vm_id            = 252
  #   size             = "tiny"
  #   storage_class    = "local"
  #   disk_size_gb     = 20
  #   network_zone_key = "ceremony"
  #   tags             = ["isolated", "maintenance", "security"]
  # }
}

lxc_instances = {}
