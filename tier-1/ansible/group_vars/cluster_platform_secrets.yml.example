---
# Encrypt this file with Ansible Vault before adding credentials or private age keys.
# Keys belong to this Tier 1 cluster. Retain an independent recovery copy before bootstrap.
# For each SSH source, replace username/password with identity, identity.pub and known_hosts
# and set that source's *_git_secret_keys list. Authentication formats may differ between sources.
# For private HTTPS authorities, add their public ca.crt bundle to the corresponding Git Secret.
cluster_platform_manage_secrets: true
cluster_platform_secrets:
  flux-system/flux-git: {username: REPLACE_WITH_READ_ONLY_BOOTSTRAP_USER, password: REPLACE_WITH_SCOPED_TOKEN}
  flux-system/platform-git: {username: REPLACE_WITH_READ_ONLY_PLATFORM_USER, password: REPLACE_WITH_SCOPED_TOKEN}
  flux-system/application-git: {username: REPLACE_WITH_READ_ONLY_APPLICATION_USER, password: REPLACE_WITH_SCOPED_TOKEN}
  flux-system/sops-age:
    age.agekey: REPLACE_WITH_BOOTSTRAP_PRIVATE_AGE_KEY
  flux-system/platform-sops-age:
    age.agekey: REPLACE_WITH_PLATFORM_PRIVATE_AGE_KEY
  flux-system/application-sops-age:
    age.agekey: REPLACE_WITH_APPLICATION_PRIVATE_AGE_KEY
