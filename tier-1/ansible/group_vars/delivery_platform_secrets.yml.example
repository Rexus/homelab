---
# Copy to an ignored/encrypted local file. Keys include the owning namespace.
# Flux consumes independently retained inputs and encrypts every Secret with SOPS before publication.
# Existing Ansible/direct inputs retain their previous owner until explicit adoption.
delivery_platform_manage_secrets: true
delivery_platform_harbor_database_password: ""
delivery_platform_secrets:
  harbor/harbor-tls: {tls.crt: "", tls.key: ""}
  harbor/harbor-ca: {ca.crt: ""}
  harbor/harbor-admin: {HARBOR_ADMIN_PASSWORD: ""}
  harbor/harbor-credentials:
    secretKey: ""
    secret: ""
    JOBSERVICE_SECRET: ""
    REGISTRY_HTTP_SECRET: ""
    CSRF_KEY: ""
    REGISTRY_PASSWD: ""
    REGISTRY_HTPASSWD: ""
  harbor/harbor-token: {tls.crt: "", tls.key: ""}
  # Flux preserves Harbor internal trust through retained inputs, including on Helm upgrades.
  harbor/harbor-core-internal-tls: {ca.crt: "", tls.crt: "", tls.key: ""}
  harbor/harbor-jobservice-internal-tls: {ca.crt: "", tls.crt: "", tls.key: ""}
  harbor/harbor-registry-internal-tls: {ca.crt: "", tls.crt: "", tls.key: ""}
  harbor/harbor-portal-internal-tls: {ca.crt: "", tls.crt: "", tls.key: ""}
  harbor/harbor-trivy-internal-tls: {ca.crt: "", tls.crt: "", tls.key: ""}
  harbor/harbor-oidc:
    config.json: ""
  argocd/argocd-server-tls: {tls.crt: "", tls.key: ""}
  argocd/argocd-secret:
    server.secretkey: ""
    admin.password: ""
    admin.passwordMtime: ""
  argocd/argocd-oidc: {clientSecret: ""}
  # Native mode: preissued TLS is the default; a commissioned issuer is optional.
  # In Flux generated mode dependency passwords persist in flux_credentials_directory outside Git.
  # Retained mode requires all dependency passwords here, including on adoption and recovery.
  # Supply actual OIDC credentials and the preissued PKCS12 password here.
  spinnaker/spinnaker-oidc: {clientSecret: ""}
  # Required in preissued mode: same password used to export the seven PKCS12 keystores.
  spinnaker/spinnaker-keystore: {password: ""}
  spinnaker/spinnaker-backup:
    # S3 only; omit AWS keys entirely for filesystem backups.
    AWS_ACCESS_KEY_ID: ""
    AWS_SECRET_ACCESS_KEY: ""
    # Both backends: retain separately from cluster/NAS; never generated by this role.
    RESTIC_PASSWORD: ""
  # With external Secret ownership (manage_secrets=false), provision additionally:
  # spinnaker-mysql-root, spinnaker-redis-auth, spinnaker-keystore: key password
  # spinnaker-{clouddriver,echo,fiat,front50,orca}-db: keys password, migration-password
  # Use independent 32-128 character ASCII alphanumeric dependency passwords.

# Preissued mode requires all ten TLS Secrets, including binary PKCS12 data for Java services.
# Values here are base64 encoded Secret.data fields. SOPS encrypts them before writing the payload.
# Keep these inputs, the matching keystore password and private CA recovery material independently.
delivery_platform_flux_secret_data:
  spinnaker/spinnaker-tls: {tls.crt: "", tls.key: ""}
  spinnaker/spinnaker-mysql-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  spinnaker/spinnaker-redis-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  spinnaker/clouddriver-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
  spinnaker/echo-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
  spinnaker/fiat-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
  spinnaker/front50-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
  spinnaker/gate-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
  spinnaker/orca-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
  spinnaker/rosco-tls: {tls.crt: "", tls.key: "", ca.crt: "", keystore.p12: ""}
