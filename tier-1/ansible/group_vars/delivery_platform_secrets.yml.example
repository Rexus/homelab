---
# Copy to an ignored/encrypted local file. Keys include the owning namespace.
# Existing Vault/controller-managed Secrets are the default instead.
delivery_platform_manage_secrets: true
delivery_platform_harbor_database_password: ""
delivery_platform_secrets:
  harbor/harbor-tls: {tls.crt: "", tls.key: ""}
  harbor/harbor-ca: {ca.crt: ""}
  harbor/harbor-admin: {HARBOR_ADMIN_PASSWORD: ""}
  harbor/harbor-credentials:
    secretKey: ""
    secret: ""
    JOBSERVICE_SECRET: ""
    REGISTRY_HTTP_SECRET: ""
    CSRF_KEY: ""
    REGISTRY_PASSWD: ""
    REGISTRY_HTPASSWD: ""
  harbor/harbor-token: {tls.crt: "", tls.key: ""}
  harbor/harbor-oidc:
    config.json: ""
  argocd/argocd-server-tls: {tls.crt: "", tls.key: ""}
  argocd/argocd-secret:
    server.secretkey: ""
    admin.password: ""
    admin.passwordMtime: ""
  argocd/argocd-oidc: {clientSecret: ""}
  # Native mode: preissued TLS is the default; a commissioned issuer is optional.
  # Dependency passwords are generated
  # stably under the private output/credentials directory when manage_secrets=true.
  # Supply actual OIDC credentials and the preissued PKCS12 password here.
  spinnaker/spinnaker-oidc: {clientSecret: ""}
  # Required in preissued mode: same password used to export the seven PKCS12 keystores.
  spinnaker/spinnaker-keystore: {password: ""}
  spinnaker/spinnaker-backup:
    # S3 only; omit AWS keys entirely for filesystem backups.
    AWS_ACCESS_KEY_ID: ""
    AWS_SECRET_ACCESS_KEY: ""
    # Both backends: retain separately from cluster/NAS; never generated by this role.
    RESTIC_PASSWORD: ""
  # With external Secret ownership (manage_secrets=false), provision additionally:
  # spinnaker-mysql-root, spinnaker-redis-auth, spinnaker-keystore: key password
  # spinnaker-{clouddriver,echo,fiat,front50,orca}-db: keys password, migration-password
  # Use independent 32-128 character ASCII alphanumeric dependency passwords.
