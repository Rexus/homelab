---
# Copy to an ignored/encrypted local file only for explicit bootstrap ownership.
# Flux encrypts these stable inputs into target-namespace Secrets before consumers.
# Legacy Ansible can alternatively use pre-existing secret-controller-owned Secrets.
development_platform_manage_secrets: true
development_platform_secrets:
  gitlab-root: {password: ""}
  gitlab-postgresql: {password: ""}
  gitlab-postgresql-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  gitlab-redis: {password: ""}
  gitlab-gitaly: {token: ""}
  gitlab-shell-auth: {secret: ""}
  gitlab-storage: {connection: ""}
  gitlab-backup-storage: {config: ""}
  gitlab-tls: {tls.crt: "", tls.key: ""}
  gitlab-ca: {ca.crt: ""}
  gitlab-oidc:
    provider: ""
  # Flux mode disables the chart's shared-secrets writer. Preserve these exact
  # existing values during adoption, especially Rails encryption and SSH host keys.
  gitlab-rails-secret:
    secrets.yml: ""
  gitlab-gitlab-runner-secret: {runner-registration-token: ""}
  gitlab-gitlab-workhorse-secret: {shared_secret: ""}
  gitlab-registry-secret: {registry-auth.crt: "", registry-auth.key: ""}
  gitlab-registry-notification: {secret: ""}
  gitlab-gitlab-shell-host-keys:
    ssh_host_rsa_key: ""
    ssh_host_rsa_key.pub: ""
    ssh_host_ecdsa_key: ""
    ssh_host_ecdsa_key.pub: ""
    ssh_host_ed25519_key: ""
    ssh_host_ed25519_key.pub: ""
  gitlab-runner-auth:
    runner-token: ""
    runner-registration-token: ""
  gitlab-runner-ca:
    REPLACE_WITH_GITLAB_HOST.crt: ""
