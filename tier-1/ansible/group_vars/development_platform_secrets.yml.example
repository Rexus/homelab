---
# Copy to an ignored/encrypted local file only for explicit bootstrap ownership.
# Alternatively, provision these exact Kubernetes Secrets from Vault before apply.
development_platform_manage_secrets: true
development_platform_secrets:
  gitlab-root: {password: ""}
  gitlab-postgresql: {password: ""}
  gitlab-postgresql-tls: {tls.crt: "", tls.key: "", ca.crt: ""}
  gitlab-redis: {password: ""}
  gitlab-gitaly: {token: ""}
  gitlab-shell-auth: {secret: ""}
  gitlab-storage: {connection: ""}
  gitlab-backup-storage: {config: ""}
  gitlab-tls: {tls.crt: "", tls.key: ""}
  gitlab-ca: {ca.crt: ""}
  gitlab-oidc:
    provider: ""
  gitlab-runner-auth:
    runner-token: ""
    runner-registration-token: ""
  gitlab-runner-ca:
    REPLACE_WITH_GITLAB_HOST.crt: ""
