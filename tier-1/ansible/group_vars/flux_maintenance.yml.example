---
# Schema: ../shared/ansible/roles/flux_maintenance/defaults/main.yml
# Guide: docs/05-operations/05-delivery.md
flux_maintenance_action: render
flux_maintenance_operation: inspect
flux_maintenance_kubeconfig: REPLACE_WITH_INDEPENDENT_TIER1_KUBECONFIG
flux_maintenance_context: REPLACE_WITH_TIER1_CONTEXT
flux_maintenance_source: tier1-platform
flux_maintenance_revision: REPLACE_WITH_APPROVED_FULL_COMMIT
# Match cluster_platform_flux_application_branch before resuming applications.
flux_maintenance_application_branch: delivery
flux_maintenance_approved: false
flux_maintenance_recovery_directory: REPLACE_WITH_VERIFIED_INDEPENDENT_PACKAGE_DIRECTORY
flux_maintenance_custody_accepted: false
flux_maintenance_artifact_lock_sha256: REPLACE_WITH_INDEPENDENTLY_APPROVED_ARTIFACT_LOCK_SHA256
flux_maintenance_health_checks: []
# Use affected Flux Kustomizations and/or HelmReleases, never an unrelated existing healthy resource.
# - {api_version: kustomize.toolkit.fluxcd.io/v1, kind: Kustomization, name: platform-base-flux2-release, namespace: flux-system, condition: Ready}
# A source revision affects all its consumers. The role retains their exact original pause states.
# Resume requires actual completed restore/verification Jobs, not a restored/fenced boolean.
flux_maintenance_resume_checks: []
# - api_version: batch/v1
#   kind: Job
#   namespace: REPLACE_WITH_PRODUCT_NAMESPACE
#   name: REPLACE_WITH_COMPLETED_VERIFICATION_JOB
#   uid: REPLACE_WITH_OBSERVED_JOB_UID

# Stop only explicitly selected writers owned by this source's live Flux inventory.
flux_maintenance_writers: []
# - {api_version: apps/v1, kind: Deployment, namespace: REPLACE_WITH_NAMESPACE, name: REPLACE_WITH_WRITER}

# Normally empty: activate an initially paused new recovery/graph resource only by its retained UID.
# Intentionally suspended resources remain suspended otherwise.
flux_maintenance_resume_suspended_uids: []
# Required only for an approved bootstrap `platform` advance/resume.
# Retain the accepted cluster_platform_flux_canary_sha256 value from bootstrap inputs.
flux_maintenance_canary_sha256: ""
