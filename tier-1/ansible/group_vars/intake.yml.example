# Copy to: ansible/group_vars/intake.yml
# Provisioning: terraform/deployments/intake/terraform.tfvars.example
# Service inputs/defaults: ansible/roles/software_intake/defaults/main.yml
# Guide: docs/03-deployment/stage-3-trust/step-15b-verified-intake.md
# Terraform attaches scsi1; Ansible prepares its filesystem and persistent UUID mount.

platform_host_ips:
  intake-1: 10.30.31.40

# Existing trusted HTTPS identity; these public CA/certificate and private-key paths are controller-local.
software_intake_server_name: intake.services.example.com
software_intake_tls_cert_src: /absolute/private/intake-fullchain.pem
software_intake_tls_key_src: /absolute/private/intake.key
software_intake_tls_ca_src: /absolute/private/platform-ca.pem
software_intake_allowed_cidrs: [10.10.10.0/24, 10.20.20.0/24, 10.42.20.0/24]
# A fresh dedicated data disk is formatted once; existing filesystems are never reformatted.
software_intake_data_device: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
software_intake_data_fstype: xfs
# Optional UUID pin for adopting/restoring existing storage. Keep any existing value.
software_intake_data_uuid: ""
software_intake_data_dir: /srv/intake
software_intake_min_free_bytes: 10737418240
software_intake_max_file_mb: 512
software_intake_max_scan_mb: 2048
software_intake_max_definition_age_days: 2
software_intake_quarantine_days: 14
# Approved outbound cache; credentials, URL queries and fragments are not accepted.
software_intake_environment:
  http_proxy: http://cache.internal.example.com:3128
  https_proxy: http://cache.internal.example.com:3128
  no_proxy: localhost,127.0.0.1
# The recipe applies baseline first; its package managers must use this same approved intake path.
# For preconfigured offline repositories, use an empty environment and explicitly disable this proxy.
repository_proxy_enabled: "{{ software_intake_environment.get('http_proxy', '') | length > 0 }}"
repository_proxy_url: "{{ software_intake_environment.get('http_proxy', '') }}"
repository_proxy_https_url: "{{ software_intake_environment.get('https_proxy', repository_proxy_url) }}"
# Choose offline imports below OR the native updater. Empty imports preserve installed definitions.
# Pre-stage approved files on the controller (offline bundle/SCP); the normal installer copies and loads them.
# CVD signatures are checked by native sigtool. CLD has no publisher-signature guarantee:
# only import it from the approved definition-transfer workflow with its independently approved SHA-256.
# At least daily.cvd/daily.cld must be imported or already installed for native freshness qualification.
# Keep each installed database's CVD/CLD format. Downgrades and changed same-version files are rejected.
software_intake_definition_files: []
# - name: daily.cvd
#   src: /absolute/approved/clamav/daily.cvd
#   sha256: <independently-approved-64-lowercase-hex-sha256>
# Optional entries use main.cvd/main.cld or bytecode.cvd/bytecode.cld with the same fields.
# Newer replacements retain backup copies; unrelated active definitions are preserved.
# To use online FreshClam, clear the imports and explicitly enable the qualified proxy path below.
software_intake_freshclam_enabled: false
software_intake_clam_mirrors: [database.clamav.net]
# First run intake.service manually, review every receipt and test consumers, then enable scheduling.
software_intake_timer_enabled: false
software_intake_schedule: '*-*-* 03:00:00'

# Replace [] with selected entries below, indented beneath software_intake_sources.
# Pin actual HTTPS sources/checksums/fingerprints; never generate signing keys here.
software_intake_sources: []
# - name: cli-tool
#   kind: artifact
#   url: https://downloads.example.com/tool.tar.gz
#   filename: tool.tar.gz
#   sha256: <independently-verified-64-lowercase-hex-sha256>
#   # Optional detached signature requires BOTH the local public key and its approved fingerprint.
#   signature_url: https://downloads.example.com/tool.tar.gz.asc
#   key_file: /absolute/private/vendor-public.asc
#   key_fingerprint: <approved-full-40-or-64-hex-fingerprint>
# - name: el-base
#   kind: rpm
#   url: https://repo.example.com/el/10/x86_64/baseos/os/
#   releasever: '10'
#   architectures: [x86_64, noarch]
#   repo_gpgcheck: true
#   key_file: /absolute/private/el-public.asc
#   key_fingerprint: <approved-full-40-or-64-hex-fingerprint>
# - name: deb-base
#   kind: apt
#   url: https://deb.example.com/debian/
#   distribution: trixie
#   components: [main]
#   architectures: [amd64]
#   key_file: /absolute/private/debian-public.asc
#   key_fingerprint: <approved-full-40-or-64-hex-fingerprint>
