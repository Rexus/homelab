---
# Pass explicitly: -e @ansible/group_vars/observability_platform.yml
observability_action: render
observability_kubeconfig: ""
observability_context: ""
observability_storage_class: retained-block
# Live database disks stay on independently qualified Proxmox CSI/Ceph RBD, never the NAS backup claim.
observability_database_storage_class: ""
observability_database_storage_accepted: false
observability_topology_key: infrastructure.example.org/physical-host
observability_failure_domains: [pve01, pve02, pve03]
observability_backup_destination: s3://platform-backups/grafana-db
observability_backup_endpoint: https://backup-objectstore.services.example.org
observability_backup_mode: files
observability_backup_files_phase: prepare
observability_backup_files_accepted: false
observability_backup_files:
  claim: grafana-db-backups
  volume_handle: ""  # Exact retained NFS CSI PV handle; backup destination only.
  system_identifier: ""  # status.systemID after database-only preparation.
  marker: ""  # Commissioned private NAS marker, permissions and storage encryption.
  schedule: '0 2 * * *'
observability_grafana_url: https://grafana.services.example.org
observability_dashboards_url: https://dashboards.services.example.org
observability_oidc_issuer: https://sso.identity.example.org/realms/platform
observability_oidc_operator_group: platform-observability-readers
observability_search_node_dns: [CN=opensearch.nodes.services.example.org]
observability_search_admin_dns: [CN=opensearch-bootstrap.services.example.org]
# true only for a reviewed NEW, empty cluster; false for every restart, scale or restore.
# After the first green cluster, set false and reapply to remove the initial-manager list.
observability_search_bootstrap: false
# Tier 1 pod sources (children, parent peers, metric bridge/operator proxy), plus node SNAT.
observability_netdata_allow_from: 10.245.* 10.20.20.*
# Observed source networks: Tier 0 management/projections, Tier 1 nodes, Tier 2 edge and lab nodes.
# Replace/narrow these for the actual route/SNAT policy; routed pod sources need their own CIDRs.
observability_telemetry_cidrs: [10.10.10.0/24, 10.20.20.0/24, 10.30.30.0/24, 10.42.20.0/24]
observability_operator_namespace: operations
observability_egress:
  - {cidr: REPLACE_WITH_IDP_INGRESS_IP/32, ports: [443]}  # Resolve the accepted issuer endpoint.
  - {cidr: 10.112.0.1/32, ports: [443]}  # Verify the in-cluster kubernetes Service IP.
  - {cidr: 10.20.20.110/32, ports: [6443, 10250]}  # pctl-1 API/kubelet after service translation.
  - {cidr: 10.20.20.111/32, ports: [6443, 10250]}  # pctl-2.
  - {cidr: 10.20.20.112/32, ports: [6443, 10250]}  # pctl-3; add actual workers separately.
# Add the existing backup object endpoint only when selecting the object/WAL backup path.
observability_metrics_node_port: 30317
observability_log_scopes:
  - name: application-a
    kind: application
    port: 4400
    node_port: 30400
    reader_backend_roles: [application-a-readers]
  - name: approved-security
    kind: projection
    port: 4401
    node_port: 30401
    reader_backend_roles: [approved-security-readers]
observability_metrics_read_members: [metrics-1]
observability_netdata_scrape_metrics: [netdata_system_cpu_percentage_average]
# Apply gates: set only after validating physical placement, host mounts, CNI and kernel settings.
observability_netdata_host_access_approved: false
observability_network_policy_verified: false
observability_search_kernel_verified: false
