---
# Keep the filled copy ignored and encrypted or provide it through an existing secret owner.
# Render outputs and Helm release data also contain private native configuration.
observability_netdata_child_key: ""
observability_netdata_peer_key: ""
observability_manage_secrets: false
# Exact namespace/name -> native stringData. See Stage 8 configuration.md for the full table.
observability_secrets: {}
