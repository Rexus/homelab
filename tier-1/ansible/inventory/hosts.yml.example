# Tier-owned logical hosts. IPs live in setup group vars.
all:
  vars:
    # DHCP guests need a resolvable environment-specific DNS name before Ansible runs.
    ansible_host: >-
      {{
        platform_fqdn | default(inventory_hostname)
        if (platform_host_ips | default({})).get(inventory_hostname) == 'dhcp'
        else (platform_host_ips | default({})).get(inventory_hostname, inventory_hostname)
      }}
  children:
    development_platform:
      hosts:
        git-1: {}
    development_data:
      hosts:
        gitlab-db-1: {}
        gitlab-redis-1: {}
        gitlab-gitaly-1: {}
    observability:
      hosts:
        # Dedicated-VM alternative only; normal services use the Tier 1 cluster.
        otel-1: {}
        otel-2: {}
        metrics-1: {}
        metrics-2: {}
        search-1: {}
        search-2: {}
        search-3: {}
    podman_runner:
      hosts:
        runner-1: {}
    identity_providers:
      hosts: {}
    # Kubernetes hosts share this tier's inventory, but never the Linux baseline.
    talos:
      children:
        talos_control_plane: null
        talos_workers: null
    talos_control_plane:
      hosts:
        platform-k8ctl-1: {}
        platform-k8ctl-2: {}
        platform-k8ctl-3: {}
    talos_workers:
      hosts: {}
    guests:
      children:
        development_platform: null
        development_data: null
        observability: null
        podman_runner: null
        identity_providers: null
