static_resources:
  listeners:
    - name: redis-loopback
      address: {socket_address: {address: 127.0.0.1, port_value: 16379}}
      filter_chains:
        - filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: spinnaker_redis
                cluster: redis
  clusters:
    - name: redis
      type: STRICT_DNS
      connect_timeout: 5s
      load_assignment:
        cluster_name: redis
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: spinnaker-redis.{{ delivery_platform_spinnaker_namespace }}.svc.cluster.local
                      port_value: 6379
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: spinnaker-redis.{{ delivery_platform_spinnaker_namespace }}.svc.cluster.local
          common_tls_context:
            validation_context:
              trusted_ca: {filename: /roots/platform.crt}
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: spinnaker-redis.{{ delivery_platform_spinnaker_namespace }}.svc.cluster.local
