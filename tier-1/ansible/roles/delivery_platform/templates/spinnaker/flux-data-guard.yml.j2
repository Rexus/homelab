{% set current = spinnaker_upgrade_documents | default(delivery_platform_spinnaker_documents | default([])) %}
{% set database = current | selectattr('kind', 'equalto', 'Job')
   | selectattr('metadata.name', 'equalto', 'spinnaker-databases') | first | default({}) %}
{% set roots = database.get('spec', {}).get('template', {}).get('spec', {}).get('volumes', [])
   | selectattr('name', 'equalto', 'roots') | first | default({'configMap': {'name': 'spinnaker-roots'}}) %}
{% set backup = current | selectattr('kind', 'equalto', 'Job')
   | selectattr('metadata.name', 'equalto', 'spinnaker-backup-verify') | first | default({}) %}
{% set envoy = backup.get('spec', {}).get('template', {}).get('spec', {}).get('volumes', [])
   | selectattr('name', 'equalto', 'envoy') | first | default({'configMap': {'name': 'spinnaker-envoy'}}) %}
{% for product in ['mysql', 'redis'] %}
{% set statefulset = current | selectattr('kind', 'equalto', 'StatefulSet')
   | selectattr('metadata.name', 'equalto', 'spinnaker-' ~ product) | first | default({}) %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: spinnaker-data-{{ product }}-{{ delivery_platform_spinnaker_lifecycle }}-{{ delivery_platform_spinnaker_job_revision }}{{
    '-' ~ (((delivery_platform_spinnaker_render | default('')) ~ delivery_platform_spinnaker_lifecycle ~
      delivery_platform_spinnaker_recovery_id) | hash('sha256') | truncate(10, true, '')) }}
  namespace: {{ delivery_platform_spinnaker_namespace }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ 'spinnaker-databases' if product == 'mysql' else 'spinnaker-backup' }}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext: {runAsUser: 999, runAsGroup: 999, runAsNonRoot: true, fsGroup: 999}
{% if product == 'redis' and delivery_platform_spinnaker_lifecycle in ['adopt', 'upgrade'] %}
      initContainers:
{{ lookup('ansible.builtin.template', 'spinnaker/redis-sidecar.yml.j2') | indent(8, true) }}
{% endif %}
      containers:
        - name: verify-{{ product }}
          image: {{ statefulset.get('spec', {}).get('template', {}).get('spec', {}).get('containers',
            [{'image': delivery_platform_software[product ~ '_image']}])[0].image | to_json }}
          command: [sh, -ec]
          args:
            - |
{% if delivery_platform_spinnaker_lifecycle == 'fresh' %}
              test -z "$(find /data -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit)" || {
                echo 'Fresh initialization requires an empty accepted data claim' >&2
                exit 1
              }
{% elif delivery_platform_spinnaker_lifecycle == 'recover' %}
              test "$(cat /data/.delivery-restored)" = "$RECOVERY_ID"
{% if product == 'mysql' %}
              test -d /data/mysql
              test -s /data/auto.cnf
{% else %}
              test -s /data/dump.rdb
              redis-check-rdb /data/dump.rdb
{% endif %}
{% elif product == 'mysql' %}
              count="$(mysql --host=spinnaker-mysql --user=root --ssl-mode=VERIFY_IDENTITY \
                --ssl-ca=/roots/platform.crt --batch --skip-column-names \
                --execute="SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name IN ('clouddriver','echo','fiat','front50','orca')")"
              test "$count" = 5
{% else %}
              ready=false
              for attempt in $(seq 1 60); do
                if redis-cli -h 127.0.0.1 -p 16379 ping | grep -qx PONG; then ready=true; break; fi
                sleep 2
              done
              test "$ready" = true
              redis-cli -h 127.0.0.1 -p 16379 info persistence \
                | tr -d '\r' | grep -qx 'loading:0'
{% endif %}
          env:
            - {name: RECOVERY_ID, value: {{ delivery_platform_spinnaker_recovery_id | to_json }}}
{% if delivery_platform_spinnaker_lifecycle in ['adopt', 'upgrade'] %}
            - name: {{ 'MYSQL_PWD' if product == 'mysql' else 'REDISCLI_AUTH' }}
              valueFrom:
                secretKeyRef: {name: spinnaker-{{ 'mysql-root' if product == 'mysql' else 'redis-auth' }}, key: password}
{% endif %}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
{% if delivery_platform_spinnaker_lifecycle in ['fresh', 'recover'] %}
            - {name: data, mountPath: /data, readOnly: true}
{% else %}
            - {name: roots, mountPath: /roots, readOnly: true}
{% endif %}
      volumes:
{% if delivery_platform_spinnaker_lifecycle in ['fresh', 'recover'] %}
        - {name: data, persistentVolumeClaim: {claimName: data-spinnaker-{{ product }}-0}}
{% else %}
        - name: roots
          configMap: {{ roots.configMap | to_json }}
{% if product == 'redis' %}
        - name: envoy
          configMap: {{ envoy.configMap | to_json }}
{% endif %}
{% endif %}
{% endfor %}
