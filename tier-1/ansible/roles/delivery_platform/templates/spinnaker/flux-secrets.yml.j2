{% for secret in delivery_platform_spinnaker_spec.required_secrets %}
- apiVersion: v1
  kind: Secret
  metadata: {name: {{ secret.name }}, namespace: {{ delivery_platform_spinnaker_namespace }}}
  type: Opaque
  stringData: {{ delivery_platform_checked_secrets[delivery_platform_spinnaker_namespace ~ '/' ~ secret.name] | to_json }}
{% endfor %}
- apiVersion: v1
  kind: Secret
  metadata: {name: spinnaker-ingress-ca, namespace: {{ delivery_platform_spinnaker_namespace }}}
  type: Opaque
  stringData: {ca.crt: {{ delivery_platform_spinnaker_ca_pem | to_json }}}
- apiVersion: v1
  kind: Secret
  metadata: {name: spinnaker-redis-acl, namespace: {{ delivery_platform_spinnaker_namespace }}}
  type: Opaque
  stringData:
    users.acl: |
      user default on #{{ delivery_platform_checked_secrets[delivery_platform_spinnaker_namespace ~
        '/spinnaker-redis-auth'].password | hash('sha256') }} ~* &* +@all -config -acl -shutdown -module -debug -replicaof -slaveof -migrate -flushall -flushdb
{% if delivery_platform_spinnaker_certificate_mode == 'preissued' %}
{% for name in ['spinnaker', 'spinnaker-mysql', 'spinnaker-redis'] +
                (spinnaker_native_ports.keys() | reject('equalto', 'deck') | list) %}
- apiVersion: v1
  kind: Secret
  metadata: {name: {{ name }}-tls, namespace: {{ delivery_platform_spinnaker_namespace }}}
  type: kubernetes.io/tls
  data: {{ delivery_platform_flux_secret_data[delivery_platform_spinnaker_namespace ~ '/' ~ name ~ '-tls'] | to_json }}
{% endfor %}
{% endif %}
