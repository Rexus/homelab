apiVersion: v1
kind: ServiceAccount
metadata: {name: delivery-promoter, namespace: delivery-promotion}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata: {name: delivery-promotion-policy, namespace: delivery-promotion}
data:
  policy.json: {{ delivery_promotion_policy | to_json | to_json }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: delivery-promotion-observer, namespace: flux-system}
rules:
  - apiGroups: [source.toolkit.fluxcd.io]
    resources: [gitrepositories]
    resourceNames: [tier1-applications]
    verbs: [get]
  - apiGroups: [kustomize.toolkit.fluxcd.io]
    resources: [kustomizations]
    resourceNames: [tier1-applications]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: delivery-promotion-observer, namespace: flux-system}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: delivery-promotion-observer}
subjects: [{kind: ServiceAccount, name: delivery-promoter, namespace: delivery-promotion}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: delivery-promotion-observer, namespace: {{ delivery_promotion_target.namespace }}}
rules:
  - apiGroups: [{{ 'helm.toolkit.fluxcd.io' if delivery_promotion_target.kind == 'HelmRelease' else 'apps' }}]
    resources: [{{ 'helmreleases' if delivery_promotion_target.kind == 'HelmRelease' else 'deployments' }}]
    resourceNames: [{{ delivery_promotion_target.name }}]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: delivery-promotion-observer, namespace: {{ delivery_promotion_target.namespace }}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: delivery-promotion-observer}
subjects: [{kind: ServiceAccount, name: delivery-promoter, namespace: delivery-promotion}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: delivery-promotion-worker, namespace: delivery-promotion}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: delivery-promotion-worker}}
  policyTypes: [Ingress, Egress]
  ingress: []
  egress: {{ delivery_promotion_egress | to_json }}
{% if delivery_promotion_target.kind == 'HelmRelease' %}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: {{ delivery_promotion_chart_source.name }}
  namespace: {{ delivery_promotion_target.namespace }}
spec:
  interval: 10m
  url: {{ delivery_promotion_chart_repository | to_json }}
{% endif %}
