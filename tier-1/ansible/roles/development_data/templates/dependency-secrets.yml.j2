---
# Merge only these entries into the selected Secret owner's complete Secret map.
{% set object_connection = {
  'provider': 'AWS',
  'region': development_data_s3_region,
  'endpoint': development_data_s3_endpoint,
  'path_style': true,
  'aws_access_key_id': development_data_s3_keys.application.access_key,
  'aws_secret_access_key': development_data_s3_keys.application.secret_key
} %}
{% set trusted_ca = lookup('ansible.builtin.file', development_data_ca_src)
  ~ '\n' ~ lookup('ansible.builtin.file', development_data_s3_ca_src) %}
gitlab-postgresql:
  password: {{ development_data_postgresql_password | to_json }}
gitlab-postgresql-tls:
  tls.crt: {{ lookup('ansible.builtin.file', development_data_postgresql_client_cert_src) | to_json }}
  tls.key: {{ lookup('ansible.builtin.file', development_data_postgresql_client_key_src) | to_json }}
  ca.crt: {{ lookup('ansible.builtin.file', development_data_ca_src) | to_json }}
gitlab-redis:
  password: {{ development_data_redis_password | to_json }}
gitlab-gitaly:
  token: {{ development_data_gitaly_token | to_json }}
gitlab-shell-auth:
  secret: {{ development_data_shell_token | to_json }}
gitlab-ca:
  ca.crt: {{ trusted_ca | to_json }}
gitlab-storage:
  connection: {{ object_connection | to_json | to_json }}
gitlab-backup-storage:
  config: {{ lookup('ansible.builtin.template', 's3cfg.j2') | to_json }}
