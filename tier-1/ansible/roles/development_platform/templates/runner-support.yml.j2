apiVersion: v1
kind: ServiceAccount
metadata:
  name: ci-job
  namespace: {{ development_platform_runner_namespace }}
automountServiceAccountToken: false
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ci-default-deny
  namespace: {{ development_platform_runner_namespace }}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
  ingress: []
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
    - to:
{% for cidr in development_platform_runner_allowed_cidrs %}
        - ipBlock: {cidr: {{ cidr | to_json }}}
{% endfor %}
      ports:
        - {protocol: TCP, port: 443}
        - {protocol: TCP, port: 3128}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ci-manager-api
  namespace: {{ development_platform_runner_namespace }}
spec:
  podSelector:
    matchLabels:
      app: gitlab-runner
  policyTypes: [Egress]
  egress:
    - to:
{% for cidr in development_platform_runner_api_cidrs %}
        - ipBlock: {cidr: {{ cidr | to_json }}}
{% endfor %}
      ports:
        - {protocol: TCP, port: 443}
        - {protocol: TCP, port: 6443}
