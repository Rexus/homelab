- {name: gateway-tls, keys: [tls.crt, tls.key, ca.crt]}
- {name: {{ observability_metrics_client_ca_secret }}, keys: [ca.crt]}
- {name: metrics-auth, keys: [username, password]}
- {name: prepper-auth, keys: [username, password]}
{% for scope in observability_log_scopes %}
- {name: {{ scope.name }}-clients-ca, keys: [ca.crt]}
{% endfor %}
