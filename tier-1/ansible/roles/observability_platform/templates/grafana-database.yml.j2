- apiVersion: barmancloud.cnpg.io/v1
  kind: ObjectStore
  metadata: {name: grafana-db-backup, namespace: {{ observability_namespace }}}
  spec:
    retentionPolicy: {{ observability_backup_retention }}
    configuration:
      destinationPath: {{ observability_backup_destination | to_json }}
      endpointURL: {{ observability_backup_endpoint | to_json }}
      endpointCA: {name: grafana-backup-ca, key: ca.crt}
      s3Credentials:
        accessKeyId: {name: grafana-backup-auth, key: access-key}
        secretAccessKey: {name: grafana-backup-auth, key: secret-key}
      wal: {compression: gzip, encryption: AES256}
      data: {compression: gzip, encryption: AES256}
- apiVersion: postgresql.cnpg.io/v1
  kind: Cluster
  metadata: {name: grafana-db, namespace: {{ observability_namespace }}}
  spec:
    instances: 3
    imageName: {{ observability_database_image }}
    plugins:
      - name: barman-cloud.cloudnative-pg.io
        isWALArchiver: true
        parameters: {barmanObjectName: grafana-db-backup}
    enableSuperuserAccess: false
    bootstrap:
      initdb:
        database: grafana
        owner: grafana
        secret: {name: grafana-database}
    certificates:
      serverTLSSecret: grafana-db-server-tls
      serverCASecret: grafana-db-ca
    postgresql:
      synchronous: {method: any, number: 1, dataDurability: required, failoverQuorum: true}
      pg_hba:
        - hostnossl all all all reject
        - hostssl grafana grafana all scram-sha-256
    storage:
      storageClass: {{ observability_storage_class }}
      size: {{ observability_database_size }}
    affinity:
      enablePodAntiAffinity: true
      podAntiAffinityType: required
      topologyKey: {{ observability_topology_key }}
    resources:
      requests: {cpu: 500m, memory: 1Gi}
      limits: {cpu: '2', memory: 2Gi}
- apiVersion: postgresql.cnpg.io/v1
  kind: ScheduledBackup
  metadata: {name: grafana-db, namespace: {{ observability_namespace }}}
  spec:
    schedule: '0 0 2 * * *'
    backupOwnerReference: self
    cluster: {name: grafana-db}
    method: plugin
    pluginConfiguration: {name: barman-cloud.cloudnative-pg.io}
    immediate: true
