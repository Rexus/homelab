- {name: grafana-tls, keys: [tls.crt, tls.key, ca.crt]}
- {name: grafana-admin, keys: [username, password]}
- {name: grafana-database, keys: [username, password, secret-key]}
- {name: grafana-db-server-tls, keys: [tls.crt, tls.key], type: kubernetes.io/tls}
- {name: grafana-db-ca, keys: [ca.crt]}
{% if observability_backup_mode == 'object' %}
- {name: grafana-backup-ca, keys: [ca.crt]}
- {name: grafana-backup-auth, keys: [access-key, secret-key]}
{% else %}
- {name: grafana-db-client-ca, keys: [ca.crt]}
- {name: grafana-db-replication, keys: [tls.crt, tls.key], type: kubernetes.io/tls}
- {name: grafana-db-file-backup, keys: [tls.crt, tls.key, ca.crt], type: kubernetes.io/tls}
{% endif %}
- {name: metrics-reader, keys: [username, password]}
- {name: grafana-oidc, keys: [client-secret]}
- {name: oidc-ca, keys: [ca.crt]}
