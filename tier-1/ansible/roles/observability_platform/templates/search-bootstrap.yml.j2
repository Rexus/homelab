- apiVersion: batch/v1
  kind: Job
  metadata:
    name: search-security-{{ (lookup('ansible.builtin.template', 'search-policy.yml.j2') ~ observability_search_users_checksum ~ (observability_search_replicas | string)) | hash('sha256') | truncate(10, true, '') }}
    namespace: {{ observability_namespace }}
  spec:
    backoffLimit: 2
    activeDeadlineSeconds: 600
    template:
      spec:
        restartPolicy: Never
        automountServiceAccountToken: false
        securityContext: {runAsUser: 1000, fsGroup: 1000}
        containers:
          - name: security
            image: opensearchproject/opensearch:3.9.0
            command: [/bin/bash, -ec]
            args:
              - >-
                /usr/share/opensearch/plugins/opensearch-security/tools/securityadmin.sh
                -h opensearch -p 9200 -cn opensearch
                -cacert /admin/ca.crt -cert /admin/tls.crt -key /admin/tls.key
                -cd /policy;
{% for scope in observability_log_scopes %}
                curl --fail --silent --show-error --output /dev/null --cacert /admin/ca.crt --cert /admin/tls.crt --key /admin/tls.key
                -H 'Content-Type: application/json' -X PUT
                https://opensearch:9200/_index_template/{{ scope.name }}
                -d '{{ {"index_patterns": [scope.kind ~ "-" ~ scope.name ~ "-*"], "template": {"settings": {"number_of_shards": 1, "number_of_replicas": 1}}} | to_json }}';
{% endfor %}
                curl --fail --silent --show-error --cacert /admin/ca.crt --cert /admin/tls.crt --key /admin/tls.key
                'https://opensearch:9200/_cluster/health?wait_for_status=green&wait_for_nodes=%3E%3D{{ observability_search_replicas }}&timeout=120s';
            volumeMounts:
              - {name: admin, mountPath: /admin, readOnly: true}
              - {name: policy, mountPath: /policy, readOnly: true}
        volumes:
          - {name: admin, secret: {secretName: search-admin-tls}}
          - name: policy
            projected:
              sources:
                - secret: {name: opensearch-securityconfig}
                - secret: {name: search-users}
