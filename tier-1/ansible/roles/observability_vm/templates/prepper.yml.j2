{% for scope in observability_vm_log_scopes %}
{% set scope_index = loop.index0 %}
{% for signal in ['logs', 'traces'] %}
{% if signal == 'logs' or scope.kind == 'application' %}
{{ scope.name }}-{{ signal }}:
  workers: 2
  source:
    {{ 'otel_logs_source' if signal == 'logs' else 'otel_trace_source' }}:
      port: {{ 21890 + 2 * scope_index + loop.index0 }}
      ssl: true
      sslKeyCertChainFile: /tls/tls.crt
      sslKeyFile: /tls/tls.key
      authentication:
        http_basic:
          username: {{ observability_vm_prepper_auth.username | to_json }}
          password: {{ observability_vm_prepper_auth.password | to_json }}
  buffer:
    bounded_blocking: {buffer_size: 10240, batch_size: 1024}
{% if signal == 'logs' and scope.kind == 'projection' %}
  processor:
{% for field in ['body', 'body/record'] %}
    - parse_json:
        source: {{ field }}
        destination: {{ field }}
        overwrite_if_destination_exists: true
        tags_on_failure: [projection_record_parse_failure]
{% endfor %}
{% endif %}
  sink:
    - opensearch:
        hosts:
{% for member in observability_vm_search_hosts %}
          - https://{{ observability_vm_endpoints[member] }}:9200
{% endfor %}
        cert: /tls/ca.crt
        insecure: false
        username: data-prepper
        password: {{ observability_vm_prepper_search_password | to_json }}
        index_type: custom
        index: '{{ scope.kind }}-{{ scope.name }}-{{ signal }}-%{yyyy.MM.dd}'
        number_of_shards: 1
        number_of_replicas: 1
{% endif %}
{% endfor %}
{% endfor %}
