{% if observability_vm_service == 'collector' %}
VM_USERNAME={{ observability_vm_metrics_auth.username }}
VM_PASSWORD={{ observability_vm_metrics_auth.password }}
DP_USERNAME={{ observability_vm_prepper_auth.username }}
DP_PASSWORD={{ observability_vm_prepper_auth.password }}
{% elif observability_vm_service == 'metrics' %}
VM_httpAuth_username={{ observability_vm_metrics_auth.username }}
VM_httpAuth_password={{ observability_vm_metrics_auth.password }}
{% elif observability_vm_service == 'search' %}
DISABLE_INSTALL_DEMO_CONFIG=true
OPENSEARCH_JAVA_OPTS=-Xms{{ observability_vm_search_heap }} -Xmx{{ observability_vm_search_heap }}
{% elif observability_vm_service == 'prepper' %}
JAVA_OPTS=-Xms1g -Xmx1g
{% elif observability_vm_service == 'dashboards' %}
SEARCH_PASSWORD={{ observability_vm_dashboards_search_password }}
OPENID_CLIENT_SECRET={{ observability_vm_oidc_dashboards_secret }}
{% elif observability_vm_service == 'grafana' %}
GF_PATHS_CONFIG=/config/config.ini
GF_PATHS_DATA=/data
GF_PATHS_LOGS=/data/logs
GF_PATHS_PLUGINS=/data/plugins
GF_PATHS_PROVISIONING=/config/provisioning
GF_SECURITY_ADMIN_PASSWORD={{ observability_vm_grafana_admin_password }}
GF_SECURITY_SECRET_KEY={{ observability_vm_grafana_secret_key }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ observability_vm_oidc_grafana_secret }}
{% endif %}
