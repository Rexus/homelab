# One authorized source; no host repositories or host RPM database.
[main]
cachedir={{ intake_work.path }}/fetch/rpm-cache
persistdir={{ intake_work.path }}/fetch/rpm-state
logdir={{ intake_work.path }}/fetch/rpm-log
reposdir={{ intake_work.path }}/fetch/rpm-repos
gpgcheck=1
localpkg_gpgcheck=1
sslverify=1
skip_if_unavailable=0
keepcache=1

[{{ intake_source.name }}]
name={{ intake_source.name }}
baseurl={{ intake_source.url }}
enabled=1
gpgcheck=1
repo_gpgcheck={{ intake_source.repo_gpgcheck | default(false) | bool | ternary(1, 0) }}
gpgkey=file://{{ intake_config_dir }}/keys/{{ intake_source.name }}.asc
sslverify=1
skip_if_unavailable=0
module_hotfixes=1
