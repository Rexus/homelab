[defaults]
collections_path = {{ software_intake_collections_dir }}
collections_scan_sys_path = false
roles_path = {{ software_intake_runtime_dir }}/roles
local_tmp = {{ software_intake_data_dir }}/private/ansible
remote_tmp = {{ software_intake_data_dir }}/runtime-tmp
interpreter_python = /usr/bin/python3
host_key_checking = true
retry_files_enabled = false
display_args_to_stdout = false

[privilege_escalation]
become_flags = -H -S -n -k
