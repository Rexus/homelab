# Copy to: terraform/common.tfvars
# Tier-specific Linux guest networks and optional overrides.
# Shared defaults: ../shared/config/platform.tfvars
# Approved images: ../shared/templates/proxmox-catalog.tfvars
# shared/scripts/deploy.sh loads both before this file.
# Guide: docs/reference/platform-inputs.md

# Shared application attachment: shared_network_zones in the platform profile.
# Keep only tier-specific networks here, or a complete entry to override a shared network.
# Consuming DNS or an issuer does not require attaching to its provider's network.
# SDN: use the VNet ID as bridge, without a second VLAN tag.
# Non-SDN: use a VLAN-aware bridge plus vlan_id. Review every reference value.
network_zones = {
  observability = {
    bridge       = "obs"
    vlan_id      = null
    cidr_ipv4    = "10.20.30.0/24"
    gateway_ipv4 = "10.20.30.1"
  }
  storage = {
    bridge       = "stor"
    vlan_id      = null
    cidr_ipv4    = "10.20.40.0/24"
    gateway_ipv4 = "10.20.40.1"
  }
  telemetry_gateway = {
    bridge       = "tgw"
    vlan_id      = null
    cidr_ipv4    = "10.20.31.0/24"
    gateway_ipv4 = "10.20.31.1"
  }
  security_telemetry = {
    bridge       = "sectel"
    vlan_id      = null
    cidr_ipv4    = "10.20.32.0/24"
    gateway_ipv4 = "10.20.32.1"
  }
  external_edge = {
    bridge       = "vmbr0"
    vlan_id      = 320
    cidr_ipv4    = "10.30.30.0/24"
    gateway_ipv4 = "10.30.30.1"
  }
}

# Optional tier-wide overrides:
# default_platform_node_name = "pve02"
# default_linux_vm_template_id = 9100
# proxmox_storage_classes = { local = { vm_disk = "tier-specific-storage" } }
# Storage-map overrides replace the entire map; include all classes used here.

# SSH public keys are read from files outside Git via TF_VAR_ssh_public_key_files
# in the ignored .env.local. Never paste key material into this example.
