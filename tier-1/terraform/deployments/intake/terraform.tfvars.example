# Variable definitions (this repository): terraform/deployments/intake/variables.tf

# Copy to: terraform/deployments/intake/terraform.tfvars
# Guide: docs/03-deployment/stage-03-trust/step-15b-verified-intake.md
# Input ownership and precedence: docs/08-reference/platform-inputs.md
# VMID allocation: docs/02-conventions/vmid-convention.md
# Shared supplies approved Linux template references, storage mappings and sizes.
# Tier 1 owns this VM, inventory and state; Tier 0 owns template publication.
# Terraform attaches scsi1; the deployment's Ansible role creates and mounts its guest filesystem.

vm_instances = {
  "intake-1" = {
    vm_id            = 1321
    size             = "small-mem"
    storage_class    = "local"
    disk_size_gb     = 40
    network_zone_key = "delivery_edge"
    tags             = ["software-intake", "restricted", "always-on", "delivery"]
    extra_disks = [{
      interface     = "scsi1"
      size_gb       = 200
      storage_class = "local"
    }]
  }
}

lxc_instances = {}
