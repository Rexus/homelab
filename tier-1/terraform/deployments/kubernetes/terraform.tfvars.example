# Variable definitions (this repository): terraform/deployments/kubernetes/variables.tf

# Cluster-owned hardware/configuration. This root does not load Linux common.tfvars.
# IP reservations are in ansible/group_vars/talos.yml, hosts in ansible/inventory/hosts.yml.
# VMID allocations: docs/conventions/vmid-convention.md
# Set the image ID from the shared approved catalog, and pin matching releases/schematic.
# Complete reference path: approved exact Talos 1.13.x image, installer and talosctl.
# The supplied human SSO rollout does not qualify Talos 1.14; generic version validation is not that proof.
# Configure native proxy/DNS/time or approved mirrors before denying direct egress.
# Reference: docs/deployment/stage-4-kubernetes/procedures/talos-terraform.md#controlled-image-access
# Linux common.tfvars and Ansible proxy settings do not apply to these nodes.
machine_config_patches = []

# NoCloud drive carries networking only; IPs come from tier-local platform_host_ips.
# Leave user/password/SSH/custom user-data unset. DNS inherits the host default;
# add dns_servers only if a qualified independent bootstrap DNS override is needed.
# Null retains the earlier DHCP-reservation path for existing clusters.
# SDN alternative: use sdn_vnet instead of prefix_length/gateway; match all node bridges and omit NIC tags.
# Reference: docs/reference/network-inputs.md#sdn-subnet-lookup
bootstrap_network = { prefix_length = 24, gateway = "10.20.20.1" }

template_vm_id = 9102
# New-cluster profile: match the approved UEFI-only NoCloud template.
# Do not copy this profile onto an existing BIOS cluster as an update.
vm_firmware = { bios = "ovmf", machine = "q35", scsi_hardware = "virtio-scsi-pci" }
qemu_agent  = true # Requires siderolabs/qemu-guest-agent in the image and installer schematic.
cluster = {
  name               = "platform"
  endpoint           = "https://kubernetes.platform.example.com:6443"
  bootstrap_node     = "pctl-1"
  talos_version      = "REPLACE_WITH_EXACT_VERSION_WITH_v"
  kubernetes_version = "REPLACE_WITH_COMPATIBLE_VERSION_WITHOUT_v"
  installer_image    = "REPLACE_WITH_INSTALLER_MATCHING_TEMPLATE_SCHEMATIC_AND_VERSION"
  pod_cidr           = "10.245.0.0/16"
  service_cidr       = "10.112.0.0/16"
  allow_scheduling_on_control_planes = true
}

# Reserve each inventory IP outside DHCP and set its static NoCloud network. The endpoint needs an external
# TCP load balancer for these control planes; it cannot use in-cluster ingress.
# Keep host placement, storage, bridges, and image source in the same Proxmox cluster.
nodes = {
  pctl-1 = {
    vm_id = 1001, node_name = "pve01", mac_address = "02:00:00:00:13:00"
    datastore_id = "shared", bridge = "app", size = "medium"
  }
  pctl-2 = {
    vm_id = 1002, node_name = "pve02", mac_address = "02:00:00:00:13:01"
    datastore_id = "shared", bridge = "app", size = "medium"
  }
  pctl-3 = {
    vm_id = 1003, node_name = "pve03", mac_address = "02:00:00:00:13:02"
    datastore_id = "shared", bridge = "app", size = "medium"
  }
}

# Start with three schedulable control planes. Optional workers need matching
# inventory hosts, DHCP/IP reservations, and hardware entries in nodes above.
# Reserve optional worker VMIDs from 1101 onward; do not renumber existing guests.
# Existing clusters must retain their workers; this example is not a removal plan.

# Add specialized workers when needed. Set pool = "compute" to emit
# the Kubernetes node-pool label. Manage taints through the Kubernetes API;
# use matching workload selectors/tolerations. Pools do not create security boundaries.
