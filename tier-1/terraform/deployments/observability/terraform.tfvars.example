# Variable definitions (this repository): terraform/deployments/observability/variables.tf

# Copy to: terraform/deployments/observability/terraform.tfvars
# Guide: docs/03-deployment/stage-8-observability/step-1b-dedicated-vms.md
# VMID allocations: docs/02-conventions/vmid-convention.md
# Optional dedicated-VM alternative to the Tier 1 Kubernetes observability workloads.
# Separate gateway, metrics and search roles scale independently.
# Terraform provisions VM/disks; Ansible installs the native Podman/systemd products.
# Use an approved EL10 x86_64 template and approved repositories with Podman >= 5.4; EL9 is also supported.
# Each scsi1 data disk matches observability_vm_data_device; mounts persist by UUID.
# Protected syslog/audit intake and archive stay in Tier 0.
# Existing sites must migrate deliberately; never replace live inputs with this example.

vm_instances = {
  # Keys match the tier-local Ansible inventory and platform_host_ips.
  # Initial placement is not a persistent Proxmox anti-affinity rule.
  "otel-1" = {
    vm_id             = 1401
    proxmox_node_name = "pve01"
    size              = "large"
    cores             = 4
    memory            = 12288
    storage_class     = "local"
    disk_size_gb      = 40
    extra_disks       = [{ interface = "scsi1", size_gb = 80 }]
    network_zone_key  = "observability"
    tags              = ["otel-collector", "internal", "always-on", "platform"]
  }
  "otel-2" = {
