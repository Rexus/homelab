# Copy to: terraform/deployments/observability/terraform.tfvars
# Guide: docs/deployment/stage-8-observability/step-1b-dedicated-vms.md
# VMID allocations: docs/conventions/vmid-convention.md
# Optional dedicated-VM alternative to the Tier 1 Kubernetes observability workloads.
# Separate gateway, metrics and search roles scale independently.
# Terraform and the Ansible recipe create VMs and OS baseline only.
# Product services, replication, query routing and UI remain runtime integration.
# Protected syslog/audit intake and archive stay in Tier 0.
# Existing sites must migrate deliberately; never replace live inputs with this example.

vm_instances = {
  # Keys match the tier-local Ansible inventory and platform_host_ips.
  # Initial placement is not a persistent Proxmox anti-affinity rule.
  "otel-1" = {
    vm_id             = 1401
    proxmox_node_name = "pve01"
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "observability"
    tags              = ["otel-collector", "internal", "always-on", "platform"]
  }
  "otel-2" = {
    vm_id             = 1402
    proxmox_node_name = "pve02"
    size              = "small"
    storage_class     = "local"
    disk_size_gb      = 40
    network_zone_key  = "observability"
    tags              = ["otel-collector", "internal", "always-on", "platform"]
  }
  "metric-1" = {
    vm_id             = 1411
    proxmox_node_name = "pve01"
    size              = "large"
    storage_class     = "local"
    disk_size_gb      = 500
    network_zone_key  = "observability"
    tags              = ["victoriametrics", "internal", "always-on", "platform"]
  }
  "metric-2" = {
    vm_id             = 1412
    proxmox_node_name = "pve02"
    size              = "large"
    storage_class     = "local"
    disk_size_gb      = 500
    network_zone_key  = "observability"
    tags              = ["victoriametrics", "internal", "always-on", "platform"]
  }
  "search-1" = {
    vm_id             = 1421
    proxmox_node_name = "pve01"
    size              = "large"
    storage_class     = "local"
    disk_size_gb      = 1000
    network_zone_key  = "observability"
    tags              = ["opensearch", "internal", "always-on", "platform"]
  }
  "search-2" = {
    vm_id             = 1422
    proxmox_node_name = "pve02"
    size              = "large"
    storage_class     = "local"
    disk_size_gb      = 1000
    network_zone_key  = "observability"
    tags              = ["opensearch", "internal", "always-on", "platform"]
  }
  "search-3" = {
    vm_id             = 1423
    proxmox_node_name = "pve03"
    size              = "large"
    storage_class     = "local"
    disk_size_gb      = 1000
    network_zone_key  = "observability"
    tags              = ["opensearch", "internal", "always-on", "platform"]
  }
}

lxc_instances = {}
