# Copy to: terraform/deployments/podman-runner/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/deployment/stage-9-development/step-2b-podman-runner.md
# Shared values live in ../../common.tfvars.

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 111

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  "runner-1" = {
    vm_id            = 310
    size             = "medium"
    storage_class    = "local"
    disk_size_gb     = 80
    network_zone_key = "delivery_edge"
    tags             = ["gitlab-runner", "podman", "bootc", "restricted", "always-on", "delivery"]
  }
  # "runner-2" = {
  #   vm_id            = 311
  #   size             = "medium"
  #   storage_class    = "local"
  #   disk_size_gb     = 80
  #   network_zone_key = "delivery_edge"
  #   tags             = ["gitlab-runner", "podman", "bootc", "restricted", "always-on", "delivery"]
  # }
}

lxc_instances = {}
