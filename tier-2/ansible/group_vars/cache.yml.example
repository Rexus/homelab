# Copy to: ansible/group_vars/cache.yml
# Replace every value before use.
# Guide: docs/deployment/stage-1-software-intake/proxy-cache.md

platform_host_ips:
  cache-1: 10.30.30.20
  cache-2: 10.30.30.21
  # cache-3: 10.30.30.22

# Cache hosts build the repository proxy, so they do not consume the shared
# all.yml repository_proxy_url by default. If they need an existing upstream
# proxy during bootstrap, set repository_proxy_enabled to true and point
# repository_proxy_url at that upstream proxy, not at the cache VIP.
repository_proxy_enabled: false
repository_proxy_url: ""
repository_proxy_fqdn: ""
repository_proxy_ip: ""

cache_keepalived_enabled: true
cache_keepalived_group: cache
cache_keepalived_interface: "{{ ansible_default_ipv4.interface }}"
# Keep this unique on the L2 segment. The edge example uses 30-32.
cache_keepalived_virtual_router_id: 40
# Keepalived needs CIDR form when assigning the VIP to the interface.
cache_proxy_vip_cidr: "<cache_proxy_vip>/<prefix>"
cache_proxy_name: cache
cache_proxy_fqdn: "{{ cache_proxy_name }}.{{ platform_domain }}"
cache_proxy_port: 3128
# Plain IP form for consumers that cannot use CIDR, such as /etc/hosts.
cache_proxy_vip: >-
  {{
    cache_proxy_vip_cidr | regex_replace('/.*$', '')
    if cache_proxy_vip_cidr | default('') | trim
    else ''
  }}
cache_proxy_url: "http://{{ cache_proxy_fqdn }}:{{ cache_proxy_port }}"
cache_keepalived_vip_cidr: "{{ cache_proxy_vip_cidr }}"
cache_keepalived_priority_base: 110
cache_keepalived_priority_step: 10

cache_squid_package_state: present
cache_squid_service_enabled: true
cache_squid_service_state: started
cache_squid_http_port: "{{ cache_proxy_port }}"
cache_manage_firewalld: true
cache_firewalld_open_proxy_port: true
cache_firewalld_open_keepalived_vrrp: true

# Repository/update cache tuning. These defaults target a small HA pair with
# 8 GB RAM and a 200-500 GB local NVMe/local SSD cache disk. Increase
# cache_squid_cache_mb when Terraform attaches a larger local cache disk.
cache_squid_cache_mem: 2048 MB
cache_squid_max_object_size_in_memory: 512 KB
cache_squid_max_object_size: 20 GB
cache_squid_cache_dir_type: ufs
# Keep below the Terraform data disk size. Example: 180000 = 180 GB cache.
cache_squid_cache_mb: 180000
cache_squid_cache_dir: /var/spool/squid
cache_squid_l1_dirs: 16
cache_squid_l2_dirs: 256
cache_squid_range_offset_limit: -1
cache_squid_quick_abort_min: 0 KB
cache_squid_quick_abort_max: 0 KB
cache_squid_quick_abort_pct: 95
cache_squid_cache_replacement_policy: heap LFUDA
cache_squid_memory_replacement_policy: heap GDSF
cache_squid_logfile_rotate: 14
cache_squid_manage_systemd_limits: true
cache_squid_limit_nofile: 65535
cache_squid_manage_sysctl: true
cache_squid_sysctl_settings:
  fs.file-max: "2097152"
  net.core.somaxconn: "65535"
  net.ipv4.ip_local_port_range: "10240 65535"
  net.ipv4.tcp_fin_timeout: "15"
  net.ipv4.tcp_tw_reuse: "1"
cache_squid_extra_options: []
# If your installed Squid supports it and IPv6 is imperfect, you may add:
# cache_squid_extra_options:
#   - dns_v4_first on

# Terraform attaches a dedicated cache disk as scsi1 in the example.
# Enterprise Linux normally discovers that as /dev/sdb. Adjust if your
# template or hypervisor exposes the disk under a different stable path.
cache_squid_data_disk_enabled: true
cache_squid_data_device: /dev/sdb
cache_squid_data_fstype: xfs
cache_squid_data_mount_opts: defaults,noatime,nodiratime,logbufs=8

# Replace with the actual approved client subnets; add later consumers deliberately.
cache_squid_allowed_cidrs:
  - 10.10.10.0/24
  - 10.30.30.0/24

# First use case: controlled repository/update access for restricted systems.
# Replace with approved repository endpoints. CONNECT forwards HTTPS without caching.
# One policy applies to all allowed CIDRs; this is not per-tier package approval.
cache_squid_allowed_domains:
  - .almalinux.org
  - .rockylinux.org
  - .fedoraproject.org
  - .epel.cloud
  - .proxmox.com
  - .debian.org
  - .ceph.com
  - .hashicorp.com
  - .github.com
  - .githubusercontent.com

# Add the actual mirror/CDN redirect destinations after reviewing the selected repositories.
# Do not force caching against source privacy/expiry or client reload instructions.
cache_squid_refresh_patterns:
  - '-i /(InRelease|Release(\.gpg)?|Packages[^/]*|Sources[^/]*|repomd\.xml)(\?.*)?$ 0 0% 0'
  - '-i (/cgi-bin/|\?) 0 0% 0'
  - '. 0 20% 4320'

# Optional upstream proxy when Squid must chain through another egress proxy.
# Leave unset for direct outbound access from the cache nodes. For disconnected
# clients, point allowed repository domains at internal mirrors
# or offline repos and use this only if those mirrors are reached through
# another proxy.
# cache_squid_upstream_proxy: upstream-proxy.example.com
# cache_squid_upstream_port: 3128

# Post-deployment validation runs from the deployment host after cache setup.
# Keep this URL aligned with cache_squid_allowed_domains and reachable from the
# cache nodes or their upstream mirror/proxy.
cache_validation_enabled: true
cache_validation_failover_enabled: true
cache_validation_url: https://mirrors.fedoraproject.org/
# Must remain outside the approved sources; a successful negative check returns HTTP 403.
cache_validation_denied_url: http://software-intake-denied.invalid/
cache_validation_connect_timeout: 5
cache_validation_timeout: 20
cache_validation_failover_settle_seconds: 8
