# Tier-owned logical hosts. IPs live in setup group vars.
# Client devices are network-policy references, not provisioned server guests.
all:
  vars:
    # DHCP guests need a resolvable environment-specific DNS name before Ansible runs.
    ansible_host: >-
      {{
        platform_fqdn | default(inventory_hostname)
        if (platform_host_ips | default({})).get(inventory_hostname) == 'dhcp'
        else (platform_host_ips | default({})).get(inventory_hostname, inventory_hostname)
      }}
  children:
    edge_load_balancers:
      hosts:
        lb-1: {}
        lb-2: {}
        lb-3: {}
    cache:
      hosts:
        cache-1: {}
        cache-2: {}
    lab:
      hosts:
        lab-1: {}
        util-1: {}
    # Kubernetes hosts share this tier's inventory, but never the Linux baseline.
    talos:
      children:
        talos_control_plane: null
        talos_workers: null
    talos_control_plane:
      hosts:
        wctl-1: {}
        wctl-2: {}
        wctl-3: {}
    talos_workers:
      hosts: {}
    guests:
      children:
        edge_load_balancers: null
        cache: null
        lab: null
