# Tier-owned logical hosts. IPs live in setup group vars.
all:
  vars:
    # DHCP guests need a resolvable environment-specific DNS name before Ansible runs.
    ansible_host: >-
      {{
        platform_fqdn | default(inventory_hostname)
        if (platform_host_ips | default({})).get(inventory_hostname) == 'dhcp'
        else (platform_host_ips | default({})).get(inventory_hostname, inventory_hostname)
      }}
  children:
    lab:
      hosts:
        lab-1: {}
        support-1: {}
    guests:
      children:
        lab: null
