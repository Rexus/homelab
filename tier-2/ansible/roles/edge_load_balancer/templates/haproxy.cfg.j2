global
  log /dev/log local0
  maxconn {{ edge_haproxy_maxconn }}
  user haproxy
  group haproxy
  stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners

defaults
  log global
  mode http
  option httplog
  option dontlognull
  timeout connect {{ edge_haproxy_timeout_connect }}
  timeout client {{ edge_haproxy_timeout_client }}
  timeout server {{ edge_haproxy_timeout_server }}

{% if edge_haproxy_stats_enabled | bool %}
listen stats
  bind {{ edge_haproxy_stats_bind }}
  mode http
  stats enable
  stats uri {{ edge_haproxy_stats_uri }}
{% endif %}

{% for frontend in edge_haproxy_frontends %}
frontend {{ frontend.name }}
  bind {{ frontend.bind }}
  mode {{ frontend.mode | default('http') }}
{% for line in frontend.extra_lines | default([]) %}
  {{ line }}
{% endfor %}
{% if frontend.default_backend is defined %}
  default_backend {{ frontend.default_backend }}
{% endif %}

{% endfor %}
{% for backend in edge_haproxy_backends | dict2items %}
backend {{ backend.key }}
  mode {{ backend.value.mode | default('http') }}
  balance {{ backend.value.balance | default('roundrobin') }}
{% for line in backend.value.extra_lines | default([]) %}
  {{ line }}
{% endfor %}
{% for server in backend.value.servers | default([]) %}
  server {{ server.name }} {{ server.address }}:{{ server.port }}{% if server.check | default(true) | bool %} check{% endif %}{% if server.extra | default('') %} {{ server.extra }}{% endif %}
{% endfor %}

{% endfor %}
