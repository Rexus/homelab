# Variable definitions (this repository): terraform/deployments/edge/variables.tf

# Copy to: terraform/deployments/edge/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/03-deployment/stage-07-delivery/procedures/edge-proxy.md
# Shared values live in ../../common.tfvars.
# VMID allocations: docs/02-conventions/vmid-convention.md

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 9101

# Fresh VMs select TPM 2.0 below; omit tpm or set tpm = null to opt out (legacy default).
# Requires tpm_state_present = false in the applied/inspected Shared clone-source reference.
# Existing VM TPM/boot hardware is preserved; this does not enable Secure Boot or encryption.
vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  # The default is a 3-node edge set. Keep matching Ansible inventory and IP
  # entries when you add or remove edge hosts.
  "lb-1" = {
    vm_id            = 2401
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 20
    tpm              = {}
    network_zone_key = "external_edge"
    tags             = ["haproxy", "keepalived", "public", "always-on", "edge"]
  }
  "lb-2" = {
    vm_id            = 2402
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 20
    tpm              = {}
    network_zone_key = "external_edge"
    tags             = ["haproxy", "keepalived", "public", "always-on", "edge"]
  }
  "lb-3" = {
    vm_id            = 2403
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 20
    tpm              = {}
    network_zone_key = "external_edge"
    tags             = ["haproxy", "keepalived", "public", "always-on", "edge"]
  }
}

lxc_instances = {}
