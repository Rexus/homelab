# Copy to: terraform/deployments/edge/terraform.tfvars
# Replace every value before use.
# Setup guide: docs/deployment/stage-7-delivery/procedures/edge-proxy.md
# Shared values live in ../../common.tfvars.
# VMID allocations: docs/conventions/vmid-convention.md

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 9101

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  # The default is a 3-node edge set. Keep matching Ansible inventory and IP
  # entries when you add or remove edge hosts.
  "lb-1" = {
    vm_id            = 2301
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 20
    network_zone_key = "external_edge"
    tags             = ["haproxy", "keepalived", "public", "always-on", "edge"]
  }
  "lb-2" = {
    vm_id            = 2302
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 20
    network_zone_key = "external_edge"
    tags             = ["haproxy", "keepalived", "public", "always-on", "edge"]
  }
  "lb-3" = {
    vm_id            = 2303
    size             = "small"
    storage_class    = "local"
    disk_size_gb     = 20
    network_zone_key = "external_edge"
    tags             = ["haproxy", "keepalived", "public", "always-on", "edge"]
  }
}

lxc_instances = {}
