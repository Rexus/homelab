# Variable definitions (this repository): terraform/deployments/lab/variables.tf

# Copy to: terraform/deployments/lab/terraform.tfvars
# Replace every value before use.
# Reference: docs/04-development/code-layout.md
# VMID allocations: docs/02-conventions/vmid-convention.md
# The 3xxx lab allocation group remains Tier 2-owned; it is not another security tier.
# Shared values live in ../../common.tfvars.

# Optional: override the shared default Linux VM template for this setup or
# environment overlay, for example when testing another supported distro.
# default_linux_vm_template_id = 9101

vm_instances = {
  # Keys match the stable logical host names in the Ansible inventory.
  # The environment prefix or suffix from Ansible becomes the Proxmox VM name.
  "lab-1" = {
    # Optional per-guest template override when one VM uses another template.
    # template_vm_id = 9100
    vm_id            = 3201
    size             = "tiny"
    storage_class    = "local"
    disk_size_gb     = 20
    network_zone_key = "application"
    tags             = ["internal", "ephemeral", "low"]
  }
}

lxc_instances = {
  "util-1" = {
    vm_id            = 3202
    # Replace with the Proxmox LXC template file ID you actually uploaded.
    template_file_id = "local:vztmpl/linux-default-change-me.tar.xz"
    size             = "tiny"
    storage_class    = "local"
    disk_size_gb     = 8
    network_zone_key = "application"
    tags             = ["internal", "ephemeral", "low"]
  }
}
